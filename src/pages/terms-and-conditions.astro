---
import Layout from "../layouts/Layout.astro";
import { termsConditionsContent } from "../data/content";

const { metadata, title, sections } = termsConditionsContent;

const BASE_URL = "https://vanguarddiagnostics.com";

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${BASE_URL}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: title,
        item: `${BASE_URL}/terms-and-conditions`,
      },
    ],
  },
];
---

<Layout
  title={metadata.title}
  description={metadata.description}
  pageSchema={pageSchema}
>
  <main class="bg-white text-foreground">
    <section class="py-12 md:py-16">
      <div class="mx-auto w-full max-w-[1120px] px-4 md:px-6">
        <h1 class="mb-8 text-[30px] font-semibold text-primary">
          {title}
        </h1>

        <div class="space-y-6 text-base leading-relaxed text-[#1a1a1a]">
          {
            sections.map((section) => (
              <>
                {section.heading && (
                  <h2 class="mt-8 text-xl font-bold uppercase text-black">
                    {section.heading}
                  </h2>
                )}
                {section.paragraphs?.map((p) => (
                  <p class="text-base">{p}</p>
                ))}
                {section.list && (
                  <ul class="list-disc space-y-2 pl-5">
                    {section.list.map((item) => (
                      <li class="text-base">{item}</li>
                    ))}
                  </ul>
                )}
              </>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
