---
import Layout from "../../layouts/Layout.astro";
import VanguardButton from "../../components/ui/VanguardButton.astro";
import { blogPosts } from "../../data/blogs";
import { images } from "../../data/images";

const BASE_URL = "https://vanguarddiagnostics.com";

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: "Vanguard Diagnostics Blog",
    url: `${BASE_URL}/blogs`,
    publisher: {
      "@id": `${BASE_URL}/#organization`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${BASE_URL}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Blogs",
        item: `${BASE_URL}/blogs`,
      },
    ],
  },
];

// Search is client-side; all posts are rendered
---

<Layout
  title="Blogs & Resources | Vanguard Diagnostics"
  description="Read the latest blogs and resources from Vanguard Diagnostics – covering hematology, typhoid, HIV diagnostics, and more."
  pageSchema={pageSchema}
>
  <main class="bg-[#f7f7f7] text-foreground">
    <!-- ─────────────────────────── PAGE TITLE ────────────────────────────── -->
    <section class="bg-white pt-6 pb-2">
      <div class="mx-auto w-full max-w-[1120px] px-4 md:px-6">
        <div
          class="flex flex-col md:flex-row w-full md:justify-between md:items-center"
        >
          <h1
            id="page-heading"
            class="text-[26px] font-semibold text-primary tracking-wide"
          >
            Blogs
          </h1>

          <form
            id="blog-search-form"
            class="flex items-center border border-gray-300 rounded-[2px] bg-white transition-colors focus-within:border-primary overflow-hidden"
          >
            <input
              id="blog-search-input"
              type="text"
              placeholder="Search..."
              aria-label="Search blogs"
              class="flex-1 px-4 py-2.5 text-base text-gray-700 placeholder-gray-500 focus:outline-none bg-transparent"
            />
            <button
              type="submit"
              class="px-4 py-2.5 text-gray-600 hover:text-gray-900 transition-colors bg-transparent border-none outline-none cursor-pointer"
              aria-label="Submit search"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"
                ></path></svg
              >
            </button>
          </form>
        </div>

        <div class="h-[3px] bg-primary w-full mt-4"></div>
      </div>
    </section>

    <!-- ─────────────────────────── MAIN LAYOUT ───────────────────────────── -->
    <section class="py-10">
      <div class="mx-auto w-full max-w-[1120px] px-4 md:px-6">
        <div
          id="blog-posts"
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8"
        >
          {
            blogPosts.map((post) => (
              <article class="bg-white flex flex-col justify-between border border-border shadow-sm">
                <div>
                  <a
                    href={post.link}
                    class="block overflow-hidden aspect-[4/3] bg-gray-100"
                    aria-label={`Read more about ${post.title}`}
                  >
                    <img
                      src={
                        post.image || images.blogs.default
                      }
                      alt={post.title}
                      class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                      loading="lazy"
                      width={400}
                      height={300}
                    />
                  </a>

                  <div class="px-6 py-5">
                    {/* Title */}
                    <h2 class="mb-3 text-[16px] font-semibold leading-snug text-primary hover:text-[#005a66] transition-colors">
                      <a href={post.link} class="hover:underline">
                        {post.title}
                      </a>
                    </h2>

                    {/* Excerpt */}
                    <p class="text-[13px] leading-relaxed text-gray-600 line-clamp-4">
                      {post.excerpt}
                    </p>
                  </div>
                </div>

                {/* Read More */}
                <div class="px-6 pb-5 pt-0">
                  <VanguardButton
                    href={post.link}
                    class="px-4 py-1.5 text-[11px] font-semibold uppercase tracking-wider"
                    aria-label={`Read more about ${post.title}`}
                  >
                    Read More
                  </VanguardButton>
                </div>
              </article>
            ))
          }
          <!-- No Results Message -->
          <div id="no-results-message" class="hidden bg-white p-6">
            <p class="text-[15px] text-gray-700 mb-4">
              Sorry, but nothing matched your search terms. Please try again
              with some different keywords.
            </p>
            <button
              id="clear-search-btn"
              type="button"
              class="inline-flex items-center justify-center rounded font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 bg-primary text-white hover:bg-[#005a66] px-5 py-2 text-base"
            >
              Back to Blogs
            </button>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<!-- ─────────────── CLIENT-SIDE SEARCH FILTER ─────────────── -->
<script>
  const form = document.getElementById("blog-search-form") as HTMLFormElement;
  const input = document.getElementById(
    "blog-search-input",
  ) as HTMLInputElement;
  const articles = document.querySelectorAll<HTMLElement>(
    "#blog-posts article",
  );
  const pageHeading = document.getElementById("page-heading");
  const noResultsMsg = document.getElementById("no-results-message");
  const clearSearchBtn = document.getElementById("clear-search-btn");

  const performSearch = (query: string) => {
    const q = query.toLowerCase();
    let matchCount = 0;

    articles.forEach((article) => {
      const text = article.innerText.toLowerCase();
      if (!q || text.includes(q)) {
        article.style.display = "";
        matchCount++;
      } else {
        article.style.display = "none";
      }
    });

    if (pageHeading) {
      pageHeading.innerText = query
        ? `Blogs : Search Results for: ${query}`
        : "Blogs";
    }

    if (noResultsMsg) {
      if (matchCount === 0 && query) {
        noResultsMsg.classList.remove("hidden");
      } else {
        noResultsMsg.classList.add("hidden");
      }
    }
  };

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    performSearch(input.value.trim());
  });

  input?.addEventListener("input", () => {
    if (!input.value.trim()) {
      performSearch("");
    }
  });

  clearSearchBtn?.addEventListener("click", () => {
    if (input) input.value = "";
    performSearch("");
  });
</script>
