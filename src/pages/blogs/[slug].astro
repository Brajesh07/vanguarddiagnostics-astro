---
import { getCollection, render } from 'astro:content';
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader";

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const frontmatter = post.data;
---

<Layout title={`${frontmatter.title} | Vanguard Diagnostics`} description={frontmatter.description}>
  <main class="bg-[#f7f7f7] py-10">
    <div class="mx-auto w-full max-w-[850px] bg-white p-8 md:p-14 shadow-sm">
      <h1 class="text-[28px] md:text-[34px] font-semibold text-primary mb-8 leading-snug">
        {frontmatter.title}
      </h1>
      
      {/* Render the MDX/Markdown Content */}
      <article class="prose max-w-none text-gray-700 prose-headings:text-primary prose-a:text-primary hover:prose-a:text-primary/80 prose-li:my-1 prose-ul:my-4 prose-p:my-4 prose-h2:mt-8 prose-h2:mb-4 prose-h3:mt-6 prose-h3:mb-3">
        <Content />
      </article>

      {/* Leave a Comment section */}
      <div class="mt-16 pt-10 border-t border-border">
        <h3 class="text-xl font-semibold text-gray-800 mb-2">Leave a Comment</h3>
        <p class="text-[13px] text-gray-500 mb-6">Your email address will not be published. Required fields are marked *</p>
        
        <form class="flex flex-col gap-4">
          <textarea 
            rows="6" 
            placeholder="Type here..." 
            class="w-full border border-border p-3 text-[14px] focus:outline-none focus:border-primary transition-colors resize-y bg-[#fafafa]"
          ></textarea>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <input 
              type="text" 
              placeholder="Name*" 
              class="border border-border p-3 text-[14px] focus:outline-none focus:border-primary transition-colors bg-[#fafafa]"
            />
            <input 
              type="email" 
              placeholder="Email*" 
              class="border border-border p-3 text-[14px] focus:outline-none focus:border-primary transition-colors bg-[#fafafa]"
            />
            <input 
              type="url" 
              placeholder="Website" 
              class="border border-border p-3 text-[14px] focus:outline-none focus:border-primary transition-colors bg-[#fafafa]"
            />
          </div>
          <div class="flex items-center gap-2 mb-2 mt-2">
            <input type="checkbox" id="save-info" class="accent-primary w-3.5 h-3.5" />
            <label for="save-info" class="text-[13px] text-gray-500">Save my name, email, and website in this browser for the next time I comment.</label>
          </div>
          <button 
            type="button"
            class="bg-primary text-white font-medium text-[14px] px-6 py-2.5 w-fit hover:bg-primary/90 transition-colors mt-2"
          >
            Post Comment »
          </button>
        </form>
      </div>
    </div>
  </main>
</Layout>
