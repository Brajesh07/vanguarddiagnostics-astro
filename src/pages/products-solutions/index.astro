---
import Layout from "../../layouts/Layout.astro";
import HorizontalCarousel from "../../components/react/HorizontalCarousel";
import { productsContent } from "../../data/content";
import { images } from "../../data/images";

const {
  metadata,
  hero,
  intro,
  categories,
  covid19,
  dengueElisa,
  flowCytometry,
  quote,
  manufacturing,
} = productsContent;
---

<Layout title={metadata.title} description={metadata.description}>
  <main class="overflow-x-hidden text-foreground">
    <!-- Hero video -->
    <section class="bg-white pt-6">
      <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster={images.heroPoster}
        class="hero-video block h-auto w-full"
        src={hero.video}></video>
    </section>

    <style>
      @media (max-width: 768px) {
        .hero-video {
          display: none;
        }
      }
    </style>
    <div class="h-[3px] w-full bg-primary"></div>

    <!-- Hematology products info -->
    <section class="bg-white py-12 md:py-16">
      <div class="flex flex-col items-center w-full">
        <h2
          class="text-[24px] font-bold leading-tight text-center md:text-left text-primary md:text-[30px]"
        >
          {intro.title}
        </h2>
        <div class="mt-4 flex flex-col md:flex-row md:gap-6">
          <div class="w-full">
            <img
              alt="Vanguard Diagnostics reagent products"
              class="h-auto w-full object-cover shadow-[0_5px_15px_rgba(0,0,0,0.1)]"
              src={intro.image}
            />
          </div>

          <article class="mt-6 max-w-[600px] px-4 md:mt-0 md:px-0">
            <p class="mt-5 text-[15px] leading-[1.8] text-[#555555]">
              {intro.description}
            </p>
            <ul class="mt-6 space-y-4">
              {
                intro.bullets.map((bullet) => (
                  <li class="flex items-start gap-3">
                    <img
                      alt=""
                      aria-hidden="true"
                      class="mt-1.5 h-3.5 w-3.5 shrink-0"
                      src={images.bulletIcon}
                    />
                    <span class="text-[15px] leading-[1.7] text-[#555555]">
                      {bullet}
                    </span>
                  </li>
                ))
              }
            </ul>
            <button
              data-product-popup-trigger
              class="mt-8 inline-flex items-center justify-center rounded border-2 border-primary bg-primary px-8 py-2.5 text-[15px] font-semibold text-white transition-colors hover:bg-[#017d8c]"
            >
              Read More
            </button>
          </article>
        </div>
      </div>
    </section>

    <!-- Product Info Popup -->
    <div
      data-product-popup-overlay
      class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/60 opacity-0 pointer-events-none transition-opacity duration-300"
      aria-modal="true"
      role="dialog"
    >
      <div
        data-product-popup-box
        class="relative w-full max-w-[800px] aspect-[16/10] min-h-[500px] mx-4 overflow-hidden rounded-sm shadow-2xl bg-white"
        style={`background-image: url('${intro.popup.bg}'); background-size: cover; background-position: center; background-repeat: no-repeat;`}
      >
        <button
          data-product-popup-close
          aria-label="Close popup"
          class="absolute top-4 right-4 z-10 flex h-9 w-9 items-center justify-center text-black"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><line x1="18" y1="6" x2="6" y2="18"></line><line
              x1="6"
              y1="6"
              x2="18"
              y2="18"></line></svg
          >
        </button>

        <div class="p-8 md:p-12">
          <h2 class="text-lg md:text-4xl font-bold text-primary mb-8">
            {intro.popup.title}
          </h2>
          <ul class="space-y-6">
            {
              intro.popup.list.map((item) => (
                <li class="flex items-start gap-4">
                  <img
                    alt=""
                    aria-hidden="true"
                    class="mt-1.5 h-4 w-4 shrink-0"
                    src={images.bulletIcon}
                  />
                  <p class="text-[18px] md:text-[22px] font-semibold leading-[1.4] text-black">
                    {item}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <!-- Product category cards -->
    <section class="bg-[#f9f9f9] py-12 md:py-16">
      <div class="mx-auto w-full px-4 md:px-6">
        <div class="grid grid-cols-2 gap-4 md:grid-cols-4 lg:grid-cols-7">
          {
            categories.map((cat) => (
              <a
                href={cat.href}
                class="group flex flex-col items-center justify-center gap-4 border-b-4 border-b-primary bg-white p-5 text-center shadow-[0_3px_10px_rgba(0,0,0,0.08)] transition-all hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(0,0,0,0.12)]"
              >
                <img
                  alt={cat.name}
                  class="h-[100px] w-full object-contain"
                  src={cat.icon}
                />
                <span class="text-base font-bold text-[#333333] transition-colors group-hover:text-primary">
                  {cat.name}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Covid-19 -->
    <section class="bg-white py-12 md:py-16">
      <div
        class="mx-auto grid w-full max-w-[1120px] gap-12 px-4 md:grid-cols-2 md:items-center md:px-6"
      >
        <article>
          <h2 class="text-[32px] font-bold leading-tight">
            <span class="text-primary">{covid19.title.split("-")[0]}-</span>{
              covid19.title.split("-")[1]
            }
          </h2>
          <p
            class="mt-6 text-[15px] leading-[1.8] text-[#555555]"
            set:html={covid19.p1}
          />
          <p class="mt-4 text-[15px] leading-[1.8] text-[#555555]">
            {covid19.p2}
          </p>
          <a
            href={covid19.cta.href}
            target={covid19.cta.href === "#" ? undefined : "_blank"}
            rel={covid19.cta.href === "#" ? undefined : "noopener noreferrer"}
            class="mt-8 inline-flex items-center justify-center rounded border-2 border-primary bg-primary px-8 py-2.5 text-[15px] font-semibold text-white transition-colors hover:bg-[#017d8c]"
          >
            {covid19.cta.text}
          </a>
        </article>
        <img
          alt="Covid-19 shield illustration"
          class="h-auto w-full object-contain"
          src={covid19.image}
        />
      </div>
    </section>

    <!-- Dengue ELISA -->
    <section class="bg-[#f5f5f5] py-12 md:py-16">
      <div
        class="mx-auto grid w-full max-w-[1120px] gap-12 px-4 md:grid-cols-2 md:items-center md:px-6"
      >
        <img
          alt="Microwell ELISA for Dengue NS1 Antigen"
          class="h-auto w-full object-contain"
          src={dengueElisa.image}
        />
        <article>
          <h2
            class="text-[26px] font-bold leading-tight text-[#333333] md:text-[32px]"
          >
            {dengueElisa.title}
          </h2>
          <p class="mt-5 text-[16px] leading-[1.8] text-[#555555]">
            {dengueElisa.intro}
          </p>
          <ul class="mt-6 space-y-4">
            {
              dengueElisa.bullets.map((bullet) => (
                <li class="flex items-start gap-3">
                  <img
                    alt=""
                    aria-hidden="true"
                    class="mt-1.5 h-3.5 w-3.5 shrink-0"
                    src={images.bulletIcon}
                  />
                  <span class="text-[15px] leading-[1.7] text-[#555555]">
                    {bullet}
                  </span>
                </li>
              ))
            }
          </ul>
        </article>
      </div>
    </section>

    <!-- Flow Cytometry -->
    <section
      class="relative bg-cover bg-center py-16 md:py-24 norepeat"
      style={`background-image: url(${flowCytometry.bg});`}
    >
      <div
        class="relative mx-auto grid w-full max-w-[1120px] gap-12 px-4 md:grid-cols-2 md:items-center md:px-6"
      >
        <article>
          <p
            class="text-[22px] text-center font-medium leading-tight text-[#333333] md:text-[28px]"
          >
            {flowCytometry.subtitle}
          </p>
          <p
            class="text-[32px] text-center font-bold text-primary md:text-[42px]"
          >
            {flowCytometry.title}
          </p>
          <div class="flex items-center gap-2">
            <div class="flex-1 h-1 w-full bg-primary"></div>
            <p class="text-2xl md:text-5xl font-semibold text-[#333333] w-fit">
              {flowCytometry.location}
            </p>
            <div class="flex-1 h-1 w-full bg-primary"></div>
          </div>
        </article>
        <img
          alt="Flow Cytometry reagent products"
          class="h-auto w-full rounded-lg object-contain shadow-xl"
          src={flowCytometry.image}
        />
      </div>
      <div
        class="mx-auto flex w-full max-w-[1000px] md:items-start justify-center gap-6 px-4 md:px-6 md:pt-6 md:flex-row flex-col mt-20 items-center"
      >
        <img
          alt=""
          aria-hidden="true"
          class="h-16 w-auto shrink-0 md:h-24"
          src={quote.icon1}
        />
        <h2
          class="mt-4 flex-1 text-center text-[22px] font-bold leading-snug text-primary md:text-[32px]"
        >
          {quote.text}
        </h2>
        <img
          alt=""
          aria-hidden="true"
          class="h-16 w-auto shrink-0 md:self-end md:h-24"
          src={quote.icon2}
        />
      </div>
      <p class="mt-8 text-center text-[18px] font-medium text-[#555555]">
        {manufacturing.subtitle}
      </p>
    </section>

    <!-- Manufacturing carousel -->
    <section class="bg-[#f5f5f5]">
      <div class="mx-auto w-full max-w-[1120px] px-4 md:px-6"></div>
      <HorizontalCarousel
        itemHeight="h-56 md:h-72"
        items={manufacturing.images}
        title={manufacturing.title}
        client:visible
      />
    </section>

    <script>
      const overlay = document.querySelector(
        "[data-product-popup-overlay]",
      ) as HTMLElement;
      const popup = document.querySelector(
        "[data-product-popup-box]",
      ) as HTMLElement;
      const closeBtn = document.querySelector(
        "[data-product-popup-close]",
      ) as HTMLElement;
      const trigger = document.querySelector("[data-product-popup-trigger]");

      function openPopup() {
        overlay.classList.remove("opacity-0", "pointer-events-none");
        overlay.classList.add("opacity-100");
        document.body.style.overflow = "hidden";
      }

      function closePopup() {
        overlay.classList.add("opacity-0", "pointer-events-none");
        overlay.classList.remove("opacity-100");
        document.body.style.overflow = "";
      }

      trigger?.addEventListener("click", openPopup);
      closeBtn?.addEventListener("click", closePopup);

      overlay?.addEventListener("click", (e) => {
        if (!popup.contains(e.target as Node)) {
          closePopup();
        }
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closePopup();
      });
    </script>
  </main>
</Layout>
