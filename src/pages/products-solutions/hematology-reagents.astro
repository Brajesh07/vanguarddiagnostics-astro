---
import Layout from "../../layouts/Layout.astro";
import { specificProductsContent } from "../../data/content";
import PDFLinkGrid from "../../components/ui/PDFLinkGrid.astro";
import { PDFDocumentGrid } from "../../components/PDFFlipbook";

const { hematologyReagents } = specificProductsContent;
const { intro, threePart, fivePart, ifus, technicalReports } =
  hematologyReagents;
---

<Layout
  title={hematologyReagents.title}
  description={hematologyReagents.description}
>
  <main class="text-foreground">
    <!-- Hero Section -->
    <section class="w-full">
      <video autoplay loop muted playsinline class="w-full h-auto block">
        <source
          src="/images/vanguard/products-solutions/vanguarddiagnostics-product-page-banner.mp4"
          type="video/mp4"
        />
      </video>
    </section>

    <!-- Teal accent bar -->
    <div class="h-[3px] w-full bg-primary"></div>

    <!-- Content Area with Gray Background -->
    <div class="bg-[#f5f5f5] py-12">
      <div
        class="mx-auto w-full max-w-[1120px] px-4 md:px-6 flex flex-col gap-14"
      >
        <!-- Hematology Reagents Intro -->
        <section>
          <!-- Icon placeholder (blue icon in screenshot) -->
          <div class="mb-4">
            <img
              src={intro.icon}
              alt={intro.title}
              class="h-20 w-20 object-contain"
              onerror="this.style.display='none'"
            />
          </div>

          <h2
            class="text-[30px] font-bold text-primary"
            set:html={intro.title}
          />

          <div class="mt-5 space-y-4 text-[15px] leading-[1.8] text-[#555555]">
            {intro.paragraphs.map((p) => <p set:html={p} />)}
          </div>
        </section>

        <!-- 3 Part Section -->
        <section
          class="flex flex-col md:flex-row md:items-start gap-8 md:gap-12"
        >
          <div class="flex-1">
            <h3
              class="text-[26px] font-bold text-primary"
              set:html={threePart.title}
            />
            <p
              class="mt-4 text-[15px] leading-7 text-[#222222] font-semibold"
              set:html={threePart.description}
            />
            <ul class="mt-4 space-y-3">
              {
                threePart.items.map((item) => (
                  <li class="flex items-center gap-3 text-[15px] text-[#555555]">
                    <span class="inline-block h-[14px] w-[14px] shrink-0 rounded-full border-[2px] border-[#019cad]" />
                    <span set:html={item} />
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="md:w-[450px]">
            <img
              src={threePart.image}
              alt={threePart.title}
              class="w-full h-auto object-contain rounded-lg"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div
              class="hidden w-full h-48 bg-gray-200 flex-col items-center justify-center rounded-lg text-gray-500 border border-dashed border-gray-400"
            >
              <svg
                class="w-8 h-8 mb-2 text-gray-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path></svg
              >
              <span>{threePart.title} Placeholder</span>
            </div>
          </div>
        </section>

        <!-- 5 Part Section -->
        <section
          class="flex flex-col md:flex-row md:items-start gap-8 md:gap-12"
        >
          <div class="flex-1">
            <h3
              class="text-[26px] font-bold text-primary"
              set:html={fivePart.title}
            />
            <p
              class="mt-4 text-[15px] leading-7 text-[#222222] font-semibold"
              set:html={fivePart.description}
            />
            <ul class="mt-4 space-y-3">
              {
                fivePart.items.map((item) => (
                  <li class="flex items-center gap-3 text-[15px] text-[#555555]">
                    <span class="inline-block h-[14px] w-[14px] shrink-0 rounded-full border-[2px] border-[#019cad]" />
                    <span>
                      Instrument : {item.instrument} {item.models}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="md:w-[450px]">
            <img
              src={fivePart.image}
              alt={fivePart.title}
              class="w-full h-auto object-contain rounded-lg"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div
              class="hidden w-full h-48 bg-gray-200 flex-col items-center justify-center rounded-lg text-gray-500 border border-dashed border-gray-400"
            >
              <svg
                class="w-8 h-8 mb-2 text-gray-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path></svg
              >
              <span>{fivePart.title} Placeholder</span>
            </div>
          </div>
        </section>

        <!-- IFUs Section -->
        <section>
          <h3 class="text-[26px] font-bold text-primary mb-8">
            IFUs (Instructions For Use)
          </h3>
          <PDFLinkGrid docs={ifus} />
        </section>

        <!-- Technical Reports Section -->
        <section>
          <h3 class="text-[26px] font-bold text-primary mb-8">
            Technical Reports (Accuracy, Precision, Performance)
          </h3>
          <PDFLinkGrid docs={technicalReports} />
        </section>
      </div>
    </div>
  </main>
</Layout>
