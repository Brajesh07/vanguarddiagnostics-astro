---
import Layout from "../../layouts/Layout.astro";
import TrainingNavCard from "../../components/TrainingNavCard.astro";
import TrainingPopupModal from "../../components/TrainingPopupModal.astro";

const title = "Training | Vanguard Diagnostics";
const description =
  "Good training doesn't cost, it pays. Vanguard Diagnostics Training Academy offers customized programs for laboratory professionals.";

const trainingAcademyBullets = [
  "Product & benefit selling capsule",
  "Technical and hands-on training capsule for Clinical Chemistry, Hematology, ELISAs, Immunochromatography.",
  "Soft skill development capsule.",
  "Channel & Distribution Management capsule",
  "The art of selling and sales process capsule",
  "Finance for non-finance capsule",
  "Assessment and certification",
];

const capsulesBullets = [
  "The organization meets its financial targets while staying adhered to the norms.",
  "The Sales team earns its incentives by developing business.",
  "Manufacturing, QC/QA, Logistics personnel understand and comply with the cGMP, quality norms and best practices for enhanced efficiency.",
  "The brand image of the organization is reflected by a proactive and professional team.",
];

const customizedTrainingItems = [
  "Product and Benefit Selling capsule.",
  "Technical and hands-on training capsule for Clinical Chemistry, Hematology, ELISAs, Immunochromatography.",
  "Soft skill development capsule.",
  "Channel &amp; distributor management capsule.",
  "The art of selling &amp; sales process capsule.",
];

const consultingServicesItems = [
  "cGMP",
  "Quality Systems needed for India",
  "Market complaint handling",
  "Good Warehousing Practices",
  "Cold Chain Logistics etc.",
];

const trainingModelPoints = [
  "Need Analysis by the organization & Vanguard Diagnostics",
  "External Training by Vanguard Diagnostics",
  "Continued Internal Training by the Product Management Team of the organization",
];

const kpiPoints = [
  "Identify training goals and learning objectives.",
  "Integrate training strategies with organization’s corporate strategies.`",
  "Assess and define existing market scenarios.",
  "Design training materials - Canned Talks, Handouts and Manuals etc.",
  "Conduct the training program.",
  "Assess training outcomes.",
];

const heroNavCards = [
  {
    href: "#training-academy",
    src: "/images/vanguard/products-solutions/training-academy.jpg",
    alt: "Training Academy",
    label: "Training Academy",
  },
  {
    href: "#training-capsules",
    src: "/images/vanguard/products-solutions/Training-Capsules.jpg",
    alt: "Training Capsules",
    label: "Training Capsules",
  },
];

const sectionNavCards = [
  {
    href: "#our-training-model",
    src: "/images/vanguard/products-solutions/Training-Model.jpg",
    alt: "Our Training Model",
    label: "Our Training Model",
  },
  {
    href: "#performance-indicators",
    src: "/images/vanguard/products-solutions/Performance-Indicators.jpg",
    alt: "Our Performance Indicators",
    label: "Our Performance Indicators",
  },
  {
    href: "#training-programs",
    src: "/images/vanguard/products-solutions/Training-Programs-150x150.jpg",
    alt: "Training Programs",
    label: "Training Programs",
  },
  {
    href: "#benefits",
    src: "/images/vanguard/products-solutions/Training-Programs-Benefits-1.jpg",
    alt: "Benefits of Training Programs",
    label: "Benefits of Training Programs",
  },
];

const capsules = [
  { number: "1", label: "Product & Benefit Selling",                image: "/images/vanguard/products-solutions/Product-Benefit-Selling-1.jpg" },
  { number: "2", label: "Customer Relationship Management",          image: "/images/vanguard/products-solutions/Technical-hands-on-training-1.jpg" },
  { number: "3", label: "Territory Management",                     image: "/images/vanguard/products-solutions/Soft-skills-development-1.jpg" },
  { number: "4", label: "Channel & Distribution Management",         image: "/images/vanguard/products-solutions/Channel-distributor-management-1.jpg" },
  { number: "5", label: "The Art of Selling & Sales Process",       image: "/images/vanguard/products-solutions/The-art-of-selling-1.jpg" },
  { number: "6", label: "Finance for non-finance",                  image: "/images/vanguard/products-solutions/Finance-for-non-finance-1.jpg" },
  { number: "7", label: "cGMP, Quality Systems, Cold Chain & Logistics", image: "/images/vanguard/products-solutions/Logistics-1.jpg" },
];
---

<Layout title={title} description={description}>
  <main class="bg-white text-foreground pb-0">
    <!-- Hero Banner: "Good training doesn't cost, it pays." -->
    <section class="bg-white">
      <img
        src="/images/vanguard/products-solutions/training-banner-top.jpg"
        alt="Good training doesn't cost, it pays – Vanguard Diagnostics Training"
        class="block w-full h-auto object-cover"
      />
    </section>

    <!-- Accent bar -->
    <div class="h-[3px] bg-primary"></div>

    <!-- Two top icon cards: Training Academy / Training Capsules -->
    <section class="bg-[#f7f7f7] py-10">
      <div class="px-4 md:px-8">
        <div
          class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-[700px] mx-auto"
        >
          {
            heroNavCards.map((card) => (
              <TrainingNavCard
                href={card.href}
                src={card.src}
                alt={card.alt}
                label={card.label}
                variant="large"
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- Training Academy Section -->
    <section id="training-academy" class="py-14 bg-white">
      <div class="px-4 md:px-8 w-full flex justify-center">
        <div class="flex flex-col md:flex-row gap-10 items-start">
          <!-- Left: photo -->
          <div class="w-full md:max-w-[600px] shrink-0">
            <img
              src="/images/vanguard/products-solutions/training-academy-1.jpg"
              alt="Training Academy – classroom session"
              class="w-full h-auto object-cover rounded-lg shadow-sm"
            />
          </div>

          <!-- Right: content -->
          <div class="flex-1">
            <div class="flex flex-col gap-3 mb-4">
              <img
                src="/images/vanguard/products-solutions/training-academy.jpg"
                alt="Training Academy icon"
                class="w-24 h-auto object-contain"
              />
              <h1 class="text-2xl md:text-[28px] font-bold text-[#222]">
                Training Academy
              </h1>
            </div>
            <div class="h-[2px] w-14 bg-primary mb-6"></div>

            <p class="text-[15px] leading-7 text-primary mb-5">
              Customized training modules to benefit the sales teams of
              Diagnostics and Healthcare companies.
            </p>

            <ul class="space-y-2">
              {
                trainingAcademyBullets.map((item) => (
                  <li class="flex items-start gap-2 text-base text-[#555]">
                    <img
                      src="/images/vanguard/shared/bullets-1.png"
                      alt="Check icon"
                      class="w-4 h-4 object-contain"
                    />
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Training Capsules Section -->
    <section id="training-capsules" class="py-14 bg-[#f7f7f7]">
      <div class="max-w-[1120px] mx-auto px-4 md:px-8">
        <div class="flex flex-col gap-3 mb-2">
          <img
            src="/images/vanguard/products-solutions/Training-Capsules.jpg"
            alt="Training Capsules icon"
            class="w-24 h-auto object-contain"
          />
          <h2 class="text-3xl text-[#222]">
            Training <span class="text-primary"
              >Capsules (Customized Programs)</span
            >
          </h2>
        </div>
        <div class="h-[2px] w-14 bg-primary mb-6"></div>

        <div class="text-[15px] leading-7 text-[#555] space-y-4 mb-8">
          <p>
            in-vitro Diagnostics (IVD) is a part of the healthcare industry with
            a market size of ~$1.3 Bn in 2020 and the year on year growth was
            more than 20% owing to a significant higher demand. The ratio
            between import of goods and local manufacturing in India is also
            improving with the acquisition of technology and in-house R&D
            programs. India has also embraced emerging technologies like
            Molecular Diagnostics.
          </p>
          <p>
            The one area that has a scope of improvement is the effectiveness of
            our sales force. With increasing opportunities outside of the
            Diagnostics industry, the availability of candidates with desirable
            attributes keen to enter the IVD industry is dwindling.
          </p>
          <p class="text-primary">
            Vanguard Diagnostics, through its comprehensive training solutions
            intends to equip the sales team to be able to create value for the
            customers & be future ready thereby ensuring: individual
            organizations. At the end of each program, participants will receive
            a certificate of completion.
          </p>
        </div>

        <ul class="space-y-3">
          {
            capsulesBullets.map((item) => (
              <li class="flex items-center gap-4 text-base text-[#555]">
                <img
                  src="/images/vanguard/shared/bullets-1.png"
                  alt="Check icon"
                  class="w-4 h-4 object-contain"
                />
                {item}
              </li>
            ))
          }
        </ul>

        <p
          class="mt-8 text-xl text-primary italic border-l-8 border-primary pl-5 pb-8"
        >
          Brand building for the organization through the image of a
          professional team.
        </p>
      </div>
    </section>

    <!-- 4 Navigation Cards -->
    <section class="py-10 bg-white">
      <div class="max-w-[1120px] mx-auto px-4 md:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
          {
            sectionNavCards.map((card) => (
              <TrainingNavCard
                href={card.href}
                src={card.src}
                alt={card.alt}
                label={card.label}
                variant="large"
              />
            ))
          }
        </div>
      </div>
    </section>

    <!-- Our Training Model -->
    <section id="our-training-model" class="py-14 bg-[#f7f7f7]">
      <div class="px-4 md:px-8 w-full justify-center">
        <div
          class="flex flex-col lg:flex-row gap-12 items-center justify-center"
        >
          <!-- Left: large walking-figure banner -->
          <div class="w-full max-w-[690px] shrink-0">
            <img
              src="/images/vanguard/products-solutions/training-banner-3.jpg"
              alt="Training model – connected professional"
              class="w-full h-auto object-contain"
            />
          </div>

          <!-- Right: content -->
          <div class="w-full max-w-[800px]">
            <div class="flex flex-col gap-3 mb-2">
              <img
                src="/images/vanguard/products-solutions/Training-Model-1.jpg"
                alt="Training Model icon"
                class="w-24 h-auto object-contain"
              />
              <h2 class="text-[22px] font-bold text-[#222]">
                Our Training Model
              </h2>
            </div>
            <div class="h-[2px] w-14 bg-primary mb-6"></div>

            <div class="text-[15px] leading-7 text-[#555] space-y-4 mb-6">
              <p>
                The training model is specifically designed to cater to the
                needs of small to medium sized diagnostics organizations.
              </p>
              <p>The model consists of three phases:</p>
            </div>

            <ul class="space-y-3">
              {
                trainingModelPoints.map((item) => (
                  <li class="flex items-center gap-3 text-base text-[#555]">
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full border-2 border-primary text-primary shrink-0">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        class="w-3.5 h-3.5"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </span>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Performance Indicators -->
    <section id="performance-indicators" class="py-14 bg-white">
      <div class="max-w-[1120px] mx-auto px-4 md:px-8">
        <div class="flex flex-col lg:flex-row gap-12 items-center">
          <!-- Left: content -->
          <div class="flex-1">
            <div class="flex flex-col gap-3 mb-2">
              <img
                src="/images/vanguard/products-solutions/Performance-Indicators-1.jpg"
                alt="Key Performance Indicators icon"
                class="w-24 h-auto object-contain"
              />
              <h2 class="text-2xl font-bold text-primary">
                Key Performance Indicators of Vanguard Diagnostics
              </h2>
            </div>
            <div class="h-[2px] w-14 bg-primary mb-6"></div>
            <ul class="space-y-2">
              {
                kpiPoints.map((item) => (
                  <li class="flex items-start gap-2 text-base text-[#555]">
                    <span class="text-primary mt-[5px] shrink-0">
                      <svg
                        width="8"
                        height="8"
                        viewBox="0 0 10 10"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M1 5L4 8L9 2"
                          stroke="currentColor"
                          stroke-width="1.8"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </span>
                    {item}
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Right: graph image -->
          <div class="w-full lg:w-[380px] shrink-0">
            <img
              src="/images/vanguard/products-solutions/Performance-Indicators-banner-1.jpg"
              alt="Performance Indicators – growth chart"
              class="w-full h-auto object-contain"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Training Programs & Benefits Row -->
    <section id="training-programs" class="py-14 bg-[#f7f7f7]">
      <div class="max-w-[1120px] mx-auto px-4 md:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
          <!-- Card 1: Training Programs – image + teal title only -->
          <div
            class="bg-white rounded-lg border border-gray-300 flex flex-col items-center justify-center text-center px-6 py-10 min-h-[220px]"
          >
            <img
              src="/images/vanguard/products-solutions/Training-Programs-1.jpg"
              alt="Training Programs"
              class="w-28 h-28 object-contain mb-5"
            />
            <span class="text-[18px] font-bold text-primary leading-snug"
              >Training<br />Programs</span
            >
          </div>

          <!-- Card 2: Customized Training Modules text + Capsules button -->
          <div
            class="bg-white rounded-lg border border-gray-300 flex flex-col overflow-hidden min-h-[220px]"
          >
            <div
              class="flex-1 flex items-center justify-center px-6 py-8 text-center"
            >
              <p class="text-base text-[#444] leading-7">
                Customized Training Modules to benefit the Sales &amp; Product
                Management teams of Diagnostics and Healthcare companies.
              </p>
            </div>
            <button
              id="open-customized-training-popup"
              class="block w-full bg-primary text-white text-center text-base font-semibold py-3 hover:bg-primary/90 transition-colors cursor-pointer"
            >
              Capsules &gt;
            </button>
          </div>

          <!-- Card 3: Consulting services text + Capsules button -->
          <div
            class="bg-white rounded-lg border border-gray-300 flex flex-col overflow-hidden min-h-[220px]"
          >
            <div
              class="flex-1 flex items-center justify-center px-6 py-8 text-center"
            >
              <p class="text-base text-[#444] leading-7">
                Consulting services on Quality and Manufacturing for Healthcare
                companies.
              </p>
            </div>
            <button
              id="open-consulting-services-popup"
              class="block w-full bg-primary text-white text-center text-base font-semibold py-3 hover:bg-primary/90 transition-colors cursor-pointer"
            >
              Capsules &gt;
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Statistics Strip -->
    <!-- Benefits of the Training Capsules -->
    <section
      id="benefits"
      class="relative overflow-hidden py-16"
      style="background-image: url('/images/vanguard/products-solutions/training-bg-2.jpg'); background-size: cover; background-position: center;"
    >
      <!-- subtle white overlay to lighten bg slightly -->
      <div class="absolute inset-0 bg-white/40 pointer-events-none"></div>

      <div class="relative z-10 max-w-[1120px] mx-auto px-4 md:px-8">
        <!-- Checkmark icon -->
        <div class="flex justify-center mb-4">
          <img
            src="/images/vanguard/products-solutions/Training-Programs-Benefits-1.jpg"
            alt="Benefits checkmark"
            class="w-20 h-20 object-contain"
          />
        </div>

        <!-- Heading -->
        <h2 class="text-center text-[20px] font-semibold text-primary mb-10">
          Benefits of the Training Capsules
        </h2>

        <!-- Swiper Capsule Carousel -->
        <div class="capsules-swiper-wrapper mb-12">
          <div class="swiper capsules-swiper">
            <div class="swiper-wrapper">
              {
                capsules.map((cap) => (
                  <div class="swiper-slide">
                    <div
                      class="capsule-card capsule-card-clickable"
                      data-img={cap.image}
                      role="button"
                      tabindex="0"
                      aria-label={`View ${cap.label} image`}
                    >
                      <div class="capsule-card-inner">
                        <span class="capsule-number">{cap.number}</span>
                        <span class="capsule-label">{cap.label}</span>
                      </div>
                      <div class="capsule-line" />
                    </div>
                  </div>
                ))
              }
            </div>
            <!-- Pagination -->
            <div class="swiper-pagination capsules-pagination"></div>
          </div>
        </div>

        <style>
          .capsules-swiper-wrapper {
            padding-bottom: 40px;
          }
          .capsules-swiper {
            width: 100%;
            padding-bottom: 36px !important;
          }
          .capsules-swiper .swiper-slide {
            height: 100px;
            display: flex;
            align-items: stretch;
          }
          .capsule-card {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            width: 100%;
            height: 100%;
            padding: 12px 16px 0;
            background: transparent;
          }
          .capsule-card-inner {
            display: flex;
            align-items: flex-start;
            border: 1px solid rgb(218, 218, 218);
            gap: 4px;
            flex: 1;
            padding: 6px;
          }
          .capsule-number {
            font-size: 52px;
            font-weight: 700;
            color: #019cad;
            line-height: 1;
            flex-shrink: 0;
            font-family: "Roboto", sans-serif;
          }
          .capsule-label {
            font-size: 12px;
            color: #333;
            font-weight: 500;
            line-height: 1.4;
            padding-top: 6px;
            font-family: "Roboto", sans-serif;
          }
          .capsule-line {
            height: 2px;
            background-color: rgba(1, 156, 173, 0.35);
          }
          /* Clickable capsule card */
          .capsule-card-clickable {
            cursor: pointer;
            transition: box-shadow 0.2s, transform 0.2s;
          }
          .capsule-card-clickable:hover .capsule-card-inner {
            border-color: #019cad;
            box-shadow: 0 2px 12px rgba(1, 156, 173, 0.18);
          }
          .capsule-card-clickable:hover .capsule-number {
            color: #ad0118;
          }
          /* Image lightbox overlay */
          #capsule-lightbox {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 9999;
            background: rgba(0, 0, 0, 0.82);
            align-items: center;
            justify-content: center;
          }
          #capsule-lightbox.active {
            display: flex;
          }
          #capsule-lightbox-img {
            max-width: 90vw;
            max-height: 88vh;
            object-fit: contain;
            border-radius: 8px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.5);
            animation: lightbox-in 0.22s ease;
          }
          @keyframes lightbox-in {
            from { opacity: 0; transform: scale(0.94); }
            to   { opacity: 1; transform: scale(1); }
          }
          #capsule-lightbox-close {
            position: absolute;
            top: 18px;
            right: 22px;
            background: rgba(255,255,255,0.15);
            border: none;
            color: #fff;
            font-size: 28px;
            line-height: 1;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.15s;
          }
          #capsule-lightbox-close:hover {
            background: rgba(255,255,255,0.3);
          }
          /* Pagination dots */
          .capsules-pagination {
            bottom: 0 !important;
          }
          .capsules-pagination .swiper-pagination-bullet {
            width: 8px;
            height: 8px;
            background: rgba(1, 156, 173, 0.3);
            opacity: 1;
          }
          .capsules-pagination .swiper-pagination-bullet-active {
            background: #ad0118;
          }
        </style>

        <script>
          import Swiper from "swiper";
          import { Pagination, Autoplay } from "swiper/modules";
          import "swiper/css";
          import "swiper/css/pagination";

          new Swiper(".capsules-swiper", {
            modules: [Pagination, Autoplay],
            slidesPerView: 5,
            spaceBetween: 0,
            loop: true,
            autoplay: {
              delay: 3000,
              disableOnInteraction: false,
            },
            pagination: {
              el: ".capsules-pagination",
              clickable: true,
            },
            breakpoints: {
              0: { slidesPerView: 1 },
              480: { slidesPerView: 2 },
              768: { slidesPerView: 3 },
              1024: { slidesPerView: 5 },
            },
          });

          // ── Capsule image lightbox ──────────────────────────────────────
          const lightbox    = document.getElementById('capsule-lightbox');
          const lightboxImg = document.getElementById('capsule-lightbox-img');
          const closeBtn    = document.getElementById('capsule-lightbox-close');

          function openLightbox(src) {
            lightboxImg.src = src;
            lightbox.classList.add('active');
            document.body.style.overflow = 'hidden';
          }
          function closeLightbox() {
            lightbox.classList.remove('active');
            lightboxImg.src = '';
            document.body.style.overflow = '';
          }

          document.querySelectorAll('.capsule-card-clickable').forEach((card) => {
            card.addEventListener('click', () => {
              const img = card.getAttribute('data-img');
              if (img) openLightbox(img);
            });
            card.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                const img = card.getAttribute('data-img');
                if (img) openLightbox(img);
              }
            });
          });

          closeBtn.addEventListener('click', closeLightbox);
          lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox) closeLightbox();
          });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeLightbox();
          });
        </script>

        <!-- Closing bold teal quote -->
        <div class="max-w-[680px] mx-auto text-center">
          <p
            class="text-[17px] md:text-[19px] font-bold text-primary leading-8"
          >
            The proposed training solutions will create a stronger scientific
            and<br />
            professional culture that will help build loyal relationships<br />
            with your customers and a better environment for your employees.
          </p>
        </div>
      </div>
    </section>
  </main>

  <!-- Capsule image lightbox -->
  <div id="capsule-lightbox" role="dialog" aria-modal="true" aria-label="Capsule image">
    <button id="capsule-lightbox-close" aria-label="Close">&times;</button>
    <img id="capsule-lightbox-img" src="" alt="Training capsule detail" />
  </div>

  <!-- Popup: Customized Training Modules (Card 2) -->
  <TrainingPopupModal
    popupId="customized-training-popup"
    openBtnId="open-customized-training-popup"
    heading="Customized Training\u2026\u00a0 Healthcare Companies"
    intro="Finance for non-finance capsule."
    items={customizedTrainingItems}
  />

  <!-- Popup: Consulting Services on Quality & Manufacturing (Card 3) -->
  <TrainingPopupModal
    popupId="consulting-services-popup"
    openBtnId="open-consulting-services-popup"
    heading="Consulting services on Quality and Manufacturing for healthcare companies"
