---
import Layout from "../../layouts/Layout.astro";
import PDFLinkGrid from "../../components/ui/PDFLinkGrid.astro";

const title = "Reliable Biochemistry Reagents | Vanguard Diagnostics";
const description =
  "Exceptional Quality & Accuracy: Vanguard Diagnostics' Biochemistry Reagents for Reliable Laboratory Diagnostic Results.";

const allBiochemistryProducts = [
  {
    label: "Albumin with human protein calibrator",
    href: "/pdfs/Albumin-IFU.pdf",
  },
  { label: "Immunoturbidity Method CRP", href: "/pdfs/CRP-Insert_Final.pdf" },
  {
    label: "Alkaline Phosphatase, Liquid Stable",
    href: "/pdfs/Alkaline-Phosphatase-IFU.pdf",
  },
  { label: "Immunoturbidity Method ASO", href: "/pdfs/ASO-Insert_Final.pdf" },
  { label: "Amylase, Single Reagent", href: "/pdfs/Amylase-IFU.pdf" },
  {
    label: "LDL Cholesterol Direct, Enzymatic",
    href: "/pdfs/LDL-Cholesterol-IFU.pdf",
  },
  { label: "Ammonia, Liquid Stable", href: "/pdfs/Ammonia-IFU.pdf" },
  { label: "Lipase", href: "/pdfs/Lipase-IFU.pdf" },
  { label: "Adenosine Deaminase Liquid Stable", href: "/pdfs/ADA-IFU.pdf" },
  { label: "Lactate Dehydrogenase Liquid Stable", href: "/pdfs/LDH-IFU.pdf" },
  {
    label: "Bilirubin, Total & Direct",
    href: "/pdfs/VDx-Bilirubin-TD-Insert-4-reagents.pdf",
  },
  { label: "Microprotein, Pyrogallol Red", href: "/pdfs/Microprotein-IFU.pdf" },
  {
    label: "Calcium, Arsenazo III (available in mono-vials also)",
    href: "/pdfs/Calcium-IFU.pdf",
  },
  { label: "Magnesium, Single Reagent", href: "/pdfs/Magnesium-IFU.pdf" },
  { label: "Cholesterol, Single Reagent", href: "/pdfs/Cholesterol-IFU.pdf" },
  { label: "Phosphorus, Single Reagent", href: "/pdfs/Phosphorus-IFU.pdf" },
  {
    label: "Creatinine, Single Reagent & Two Reagents",
    href: "/pdfs/Creatinine-IFU.pdf",
  },
  { label: "Creatine Kinase, Liquid Stable", href: "/pdfs/CK-NAC-IFU.pdf" },
  { label: "Creatine Kinase MB, Liquid Stable", href: "/pdfs/CK-MB-IFU.pdf" },
  { label: "Chloride, Single Reagent", href: "/pdfs/Chloride-IFU.pdf" },
  { label: "D-Dimer", href: "/pdfs/D-Dimer-IFU.pdf" },
  { label: "Gamma GT, Liquid Stable", href: "/pdfs/Gamma-GT-IFU.pdf" },
  { label: "Glucose, Single Reagent", href: "/pdfs/Glucose-IFU.pdf" },
  {
    label: "HDL Cholesterol Direct, Enzymatic",
    href: "/pdfs/HDL-cholesterol-IFU.pdf",
  },
  { label: "Immunoturbidity Method RF", href: "/pdfs/RF-Insert_Final.pdf" },
  { label: "Potassium, Single Reagent", href: "/pdfs/Potassium-IFU.pdf" },
  { label: "SGOT, Highly stable NADH based", href: "/pdfs/SGOT-AST-IFU.pdf" },
  { label: "SGPT, Highly stable NADH based", href: "/pdfs/SGPT-ALT-IFU.pdf" },
  { label: "Sodium, Single Reagent", href: "/pdfs/Sodium-IFU.pdf" },
  {
    label: "Total Protein with human protein calibrator",
    href: "/pdfs/Total-Protein-IFU.pdf",
  },
  {
    label: "Triglycerides, Single Reagent",
    href: "/pdfs/Triglycerides-IFU.pdf",
  },
  { label: "Urea UV, Berthelot & Salicylate", href: "/pdfs/Urea_UV_IFU.pdf" },
  { label: "Uric Acid, Single Reagent", href: "/pdfs/Uric_Acid_Inserts.pdf" },
];

const technicalReports = [
  {
    label: "Report A",
    href: "/pdfs/5A.-Accuracy-of-the-reagent-performance-and-results.pdf",
  },
  {
    label: "Report B",
    href: "/pdfs/5B.-Accuracy-of-the-reagent-performance-and-results.pdf",
  },
];
---

<Layout title={title} description={description}>
  <main class="bg-[#efefef] text-foreground">
    <!-- Hero Banner -->
    <section class="bg-white pt-6">
      <video
        autoplay
        loop
        muted
        playsinline
        class="block h-auto w-full"
        src="/images/vanguard/products-solutions/vanguarddiagnostics-product-page-banner.mp4"
      ></video>
    </section>

    <!-- Accent bar -->
    <div class="h-[3px] bg-primary"></div>

    <!-- Main Content -->
    <section class="max-w-[1120px] mx-auto px-4 md:px-8 py-16">
      <!-- Page Title -->
      <div class="flex flex-col items-start mb-10">
        <div class="flex items-center gap-4 mb-4">
          <img
            src="/images/vanguard/product-clinical-chemistry-icon-2.png"
            alt="Biochemistry Reagents Icon"
            class="w-16 h-auto object-contain"
          />
          <h1 class="text-3xl md:text-4xl font-bold text-[#222222]">
            Biochemistry Reagents
          </h1>
        </div>
      </div>

      <!-- Introduction -->
      <div class="text-[15px] leading-7 text-[#555555] space-y-5 mb-14">
        <p>
          Vanguard Diagnostics, a renowned name in the <a
            href="/contact-us"
            class="text-primary">diagnostics sector</a
          >, offers a variety of high-quality
          <strong class="text-[#222222]">Biochemistry Reagents</strong>. These
          products offer single reagents in the liquid stable format. We offer
          <a
            href="https://pubmed.ncbi.nlm.nih.gov/6705186/"
            class="text-primary">human serum calibrators</a
          > in place of simple standards in order to ensure matrix parity and accuracy
          of results.
        </p>
        <p>
          Our <strong class="text-[#222222]">Biochemistry Reagents</strong> are rigorously
          formulated and quality tested, often surpassing industry standards. They
          are crucial for determining biochemical markers for diabetes, lipid profile,
          liver function, kidney function amongst others. Vanguard Diagnostics' Reagents
          are compatible with a wide spectrum of Biochemistry analyzers. This compatibility
          ensures seamless integration into any lab's testing processes, enhancing
          both efficiency and accuracy.
        </p>
        <p>
          Biochemistry reagents, a specialized sector of medical science, plays
          an instrumental role in diagnosing various diseases, understanding
          patient metabolism, and evaluating treatment effectiveness. Central to
          these processes are Biochemistry reagents, which facilitate the
          analysis of body fluids, predominantly blood and urine, to determine
          their chemical composition.
        </p>
      </div>

      <!-- Why are Biochemistry Reagents needed? -->
      <div class="mb-14">
        <h2 class="text-[22px] font-bold text-[#222222] mb-5">
          Why are Biochemistry Reagents needed?
        </h2>
        <div class="text-[15px] leading-7 text-[#555555] space-y-4">
          <p>
            <strong class="text-[#222222] font-bold"
              >Diagnostic Accuracy:</strong
            > Biochemistry reagents interact with specific compounds in patient samples,
            allowing for precise measurements. This precision helps healthcare professionals
            accurately diagnose a range of conditions, from diabetes to liver and
            kidney disorders, amongst others.
          </p>
          <p>
            <strong class="text-[#222222] font-bold"
              >Broad Spectrum Analysis:</strong
            > Modern medicine recognizes the complexity of human health and the myriad
            of factors affecting it. Biochemistry reagents help in analyzing a wide
            range of metabolites, proteins, and enzymes, presenting a comprehensive
            health overview. Biochemistry reagents help in analyzing a wide range
            of metabolites, proteins, and enzymes, presenting a comprehensive health
            overview.
          </p>
          <p>
            <strong class="text-[#222222] font-bold">Swift Results:</strong> Quick
            diagnosis leads to timely treatment. Using these reagents, many automated
            analyzers can provide rapid results, essential for critical care situations.
          </p>
        </div>
      </div>

      <!-- Importance of Biochemistry Reagents -->
      <div class="mb-16">
        <h2 class="text-[22px] font-bold text-[#222222] mb-5">
          Importance of Biochemistry Reagents
        </h2>
        <div class="text-[15px] leading-7 text-[#555555] space-y-4">
          <p>
            <strong class="text-[#222222] font-bold"
              >Reliable Health Assessments:</strong
            > The efficacy of Biochemistry reagents ensures that test results are
            consistent and reliable, which is pivotal for accurate health assessments.
            Any discrepancies can lead to misdiagnosis, potentially jeopardizing patient
            health.
          </p>
          <p>
            <strong class="text-[#222222] font-bold"
              >Informed Clinical Decisions:</strong
            > Clinicians rely on data-driven insights. The results derived from these
            reagents provide crucial biochemical insights, guiding doctors in prescribing
            the right treatment, adjusting medication doses, or recommending lifestyle
            changes.
          </p>
          <p>
            <strong class="text-[#222222] font-bold"
              >Monitoring Disease Progression:</strong
            > Many conditions, like kidney diseases or certain types of cancers, require
            regular monitoring. Biochemistry reagents offer consistent evaluations,
            helping doctors track disease progression or regression.
          </p>
        </div>
      </div>

      <!-- Product List -->
      <div>
        <h2 class="text-[17px] font-bold text-[#222222] mb-6">
          Vanguard brand Biochemistry Reagents for all open/ partially open
          models
        </h2>

        <div class="flex flex-col lg:flex-row gap-10">
          <!-- Two-column text link list -->
          <div class="flex-1">
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-2">
              {
                allBiochemistryProducts.map((doc) => (
                  <li class="flex items-start gap-2">
                    <img
                      class="mt-[5px] shrink-0 w-[14px] h-[14px] inline-block"
                      src="/images/vanguard/shared/bullets-1.png"
                    />
                    <a
                      href={doc.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-base underline hover:text-[#008a96] leading-snug"
                    >
                      {doc.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Side image with teal border -->
          <div
            class="w-full max-w-[382px] shrink-0 flex items-center justify-center"
          >
            <img
              src="/images/vanguard/products-solutions/new-img-open-models.png"
              alt="biochemistry reagents"
              class="w-full max-w-[382px] h-auto object-contain rounded-xl"
            />
          </div>
        </div>
      </div>

      <!-- Technical Reports -->
      <div class="py-8">
        <h2 class="text-3xl text-center font-bold text-primary mb-8">
          Technical Reports (Accuracy, Precision, Performance, Accelerated
          Stability)
        </h2>
        <PDFLinkGrid docs={technicalReports} />
      </div>
    </section>
  </main>
</Layout>
