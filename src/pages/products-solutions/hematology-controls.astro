---
import Layout from "../../layouts/Layout.astro";
import { specificProductsContent } from "../../data/content";
import PDFLinkGrid from "../../components/ui/PDFLinkGrid.astro";
import BrochureImageWithPopup from "../../components/PDFFlipbook/BrochureImageWithPopup.jsx";
import ImageGalleryWithPopup from "../../components/react/ImageGalleryWithPopup.jsx";
import PDFThumbnailWithPopup from "../../components/PDFFlipbook/PDFThumbnailWithPopup.jsx";

const { hematologyControls } = specificProductsContent;
const { hero, intro, whyNeeded, importance, ifus } = hematologyControls;
---

<Layout
  title={hematologyControls.title}
  description={hematologyControls.description}
>
  <main class="bg-[#efefef] text-foreground pb-20">
    <!-- Top graphic section -->
    <section class="bg-white pt-6">
      <video
        autoplay
        loop
        muted
        playsinline
        class="block h-auto w-full"
        src={hero.video}></video>
    </section>

    <!-- Accent bar -->
    <div class="h-[3px] bg-primary"></div>

    <section class="max-w-[1120px] mx-auto px-4 md:px-8 py-16">
      <!-- Page Title -->
      <div class="flex flex-col items-center mb-12">
        <img
          src="/images/vanguard/uploads/product-hematology-controls-icon-2.jpg"
          alt="India Map"
          class="w-20 mb-3"
        />
        <h1 class="text-3xl md:text-4xl font-bold">
          <span class="text-primary">Hematology</span> Controls
        </h1>
      </div>

      <!-- Main intro content -->
      <div class="flex flex-col md:flex-row gap-8 items-start mb-16">
        <div class="md:w-[35%] shrink-0">
          <img
            src={intro.image}
            alt="Hematology Controls Tubes"
            class="w-full h-auto object-contain rounded-md"
          />
        </div>
        <div class="md:w-[65%] text-[15px] leading-7 text-[#555555] space-y-5">
          {intro.paragraphs.map((p) => <p set:html={p} />)}
        </div>
      </div>

      <!-- Why Needed -->
      <div class="mb-14">
        <p class="mb-6" set:html={whyNeeded.paragraphs[0]} />
        <h2 class="text-[22px] font-bold text-[#222222] mb-5">
          {whyNeeded.title}
        </h2>
        <div class="text-[15px] leading-7 text-[#555555] space-y-4">
          {
            whyNeeded.items.map((item) => (
              <p>
                <strong class="text-[#222222] font-bold">{item.label}:</strong>{" "}
                {item.description}
              </p>
            ))
          }
        </div>
      </div>

      <!-- Importance -->
      <div class="mb-16">
        <h2 class="text-[22px] font-bold text-[#222222] mb-5">
          {importance.title}
        </h2>
        <div class="text-[15px] leading-7 text-[#555555] space-y-4">
          {
            importance.items.map((item) => (
              <p>
                <strong class="text-[#222222] font-bold">{item.label}:</strong>{" "}
                {item.description}
              </p>
            ))
          }
        </div>
      </div>

      <!-- Hematology Controls Product Brochure -->
      <div class="mb-16">
        <h2 class="text-[24px] font-bold text-[#222222] mb-8">
          Hematology Controls Product Brochure
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-[800px]">
          <BrochureImageWithPopup
            client:load
            imageSrc="/images/vanguard/uploads/hematology-controls-3.jpg"
            imageAlt="Hematology Controls Brochure 1"
            pdfUrl="/pdfs/Product-Brochure-Hematology-Controls.pdf"
          />
          <img
            src="https://www.vanguarddiagnostics.com/wp-content/uploads/2021/06/hematology-controls-3.jpg"
            alt="Hematology Controls Brochure 1"
            class="w-full h-auto object-contain"
          />
          <img
            src="/images/vanguard/uploads/hematology-controls-4.jpg"
            alt="Hematology Controls Brochure 2"
            class="w-full h-auto object-contain"
          />
        </div>
      </div>

      <!-- Our Specific Hematology Controls -->
      <div class="mb-16">
        <h2 class="text-[24px] font-bold text-[#222222] mb-8">
          Our Specific Hematology Controls
        </h2>
        <ImageGalleryWithPopup
          client:load
          images={[
            {
              src: "/images/vanguard/hematology/D-Check-D.jpg",
              alt: "D-Check D",
              title: "quality control in hematology",
            },
            {
              src: "/images/vanguard/hematology/D-Check-D-Plus.jpg",
              alt: "D-Check D Plus",
              title: "quality control in hematology",
            },
            {
              src: "/images/vanguard/hematology/D-Check-5Diff.jpg",
              alt: "D-Check 5Diff",
              title: "quality control in hematology",
            },
            {
              src: "/images/vanguard/hematology/D-Check-5Diff-Plus.jpg",
              alt: "D-Check 5Diff Plus",
              title: "quality control in hematology",
            },
            {
              src: "/images/vanguard/hematology/5-Open-Vial-Stability.jpg",
              alt: "Shelf Life (D-Cell 60) - WBC Change",
              title: "quality control in hematology",
            },
            {
              src: "/images/vanguard/hematology/6-Open-Vial-Stability.jpg",
              alt: "Open Vial Stability (D-Cell 60) - HGB Change",
              title: "quality control in hematology",
            },
          ]}
        />
      </div>

      <!-- Control Value Sheet -->
      <div class="mb-16">
        <h2 class="text-[24px] font-bold mb-8">
          <span class="text-primary">Control Value</span> Sheet
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <PDFThumbnailWithPopup
            client:visible
            pdfUrl="/pdfs/1-Control-Value-Sheet.pdf"
            title="Control Value Sheet 1"
          />
          <PDFThumbnailWithPopup
            client:visible
            pdfUrl="/pdfs/2-Control-Value-Sheet.pdf"
            title="Control Value Sheet 2"
          />
          <PDFThumbnailWithPopup
            client:visible
            pdfUrl="/pdfs/3-Control-Value-Sheet.pdf"
            title="Control Value Sheet 3"
          />
          <PDFThumbnailWithPopup
            client:visible
            pdfUrl="/pdfs/4-Control-Value-Sheet.pdf"
            title="Control Value Sheet 4"
          />
        </div>
      </div>

      <!-- IFUs (Instructions For Use) -->
      <div>
        <h2 class="text-[24px] font-bold text-primary mb-8">
          IFUs (Instructions For Use)
        </h2>
        <PDFLinkGrid docs={ifus} />
      </div>
    </section>
  </main>
</Layout>
