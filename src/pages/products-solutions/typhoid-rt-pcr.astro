---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { specificProductsContent } from "../../data/content";
import {
  typhoidTopBanner,
  typhoidTest1,
  typhoidTestImage,
} from "../../assets/images";
import ProductFAQ from "../../components/ui/ProductFAQ.astro";

const { typhoidRtPcr } = specificProductsContent;

const faqs = [
  {
    question: "How accurate is the RT-PCR test for typhoid?",
    answer:
      "RT-PCR is a highly sensitive and specific molecular testing method designed to detect Salmonella Typhi genetic material. Accuracy may vary depending on factors such as sample quality, timing of testing, and infection stage. It provides reliable results when performed under appropriate laboratory conditions.",
  },
  {
    question: "What is the turnaround time?",
    answer:
      "The typical turnaround time depends on the laboratory workflow and testing setup. In most cases, RT-PCR results can be available within a few hours to a day after sample processing.",
  },
  {
    question: "Is the test patented?",
    answer:
      "Yes, VANSCAN Typhoid RT-PCR Test is based on patented technology (Indian Patent No. 355208).",
  },
  {
    question: "What analyzers are compatible?",
    answer:
      "The test is designed for use on various real-time PCR platforms. For specific analyzer compatibility, please contact our technical support team.",
  },
  {
    question: "Do you supply outside India?",
    answer:
      "Yes, we do supply outside India. Please contact our sales team for more information.",
  },
];
---

<Layout title={typhoidRtPcr.title} description={typhoidRtPcr.description}>
  <main class="text-foreground bg-white">
    <div class="h-[5px] bg-primary"></div>

    <section class="w-full">
      <Image
        src={typhoidTopBanner}
        alt="Typhoid Banner"
        class="w-full h-auto object-cover"
        width={1420}
        height={700}
      />
    </section>

    <section class="bg-white py-10 md:py-14 text-center">
      <div class="mx-auto w-full max-w-[1120px] px-4 md:px-6">
        <p class="text-[16px] md:text-[18px] font-semibold text-[#1a1a1a]">
          First Typhoid RT PCR Kit based on Patented Technology
        </p>
        <h1 class="text-3xl md:text-4xl font-bold mt-4 mb-3 tracking-wide">
          <span class="text-primary">VAN</span><span class="text-[#1a1a1a]"
            >SCAN TYPHOID RT PCR TEST</span
          >
        </h1>
        <p class="text-[16px] md:text-[18px] font-semibold text-[#1a1a1a]">
          The new Gold Standard in Typhoid detection
        </p>
      </div>
    </section>

    <div class="h-[3px] w-full bg-primary/80"></div>

    <section class="py-16 md:py-20 relative bg-[#f4f7f8] overflow-hidden">
      <div class="mx-auto w-full max-w-[1120px] px-4 md:px-6 relative z-10">
        <h2
          class="text-2xl md:text-3xl font-bold text-center text-primary mb-12 md:mb-16"
        >
          The Unmet Need
        </h2>

        <div class="flex flex-col md:flex-row items-center gap-10 md:gap-16">
          <div class="w-full md:w-[45%] flex justify-center">
            <Image
              src={typhoidTest1}
              alt=""
              class="w-full h-auto"
              width={400}
              height={340}
            />
          </div>

          <div
            class="w-full md:w-[55%] text-[15px] md:text-[16px] leading-relaxed text-[#1a1a1a] space-y-5"
          >
            <!-- Direct-answer paragraph for featured snippet / AI engine extraction -->
            <p class="font-semibold text-black">
              The VANSCAN Typhoid RT-PCR test is a molecular diagnostic assay
              that detects <em>Salmonella typhi</em> and <em
                >Salmonella paratyphi</em
              >
              DNA directly from human blood. Based on patented technology (Indian
              Patent No. 355208), it enables accurate diagnosis from Day 1 of infection
              — delivering higher sensitivity and specificity than Widal or rapid-card
              tests.
            </p>

            <p>
              Introducing <span class="text-primary font-bold">VAN</span><span
                class="text-[#1a1a1a] font-bold">SCAN</span
              >
              <span class="font-bold text-[#1a1a1a]">Typhoid RT PCR</span>, the
              first-ever patented technology-based <span
                class="font-bold text-[#1a1a1a]">Typhoid RT PCR</span
              > kit by <a
                href="/contact-us"
                class="text-primary font-medium hover:underline hover:text-[#005a66] transition-colors"
                >Vanguard Diagnostics</a
              >. This innovative test sets a new gold standard for detecting
              Typhoid fever, addressing the long-standing need for reliable and
              rapid detection of Salmonella typhi and paratyphi. Unlike existing
              tests, such as Widal and rapid cards, <span
                class="text-primary font-bold">VAN</span
              ><span class="text-[#1a1a1a] font-bold">SCAN</span> offers superior
              sensitivity and specificity. By enabling early detection on day one
              of infection, this test facilitates timely administration of appropriate
              antibiotics, contributing significantly to combating Antimicrobial Resistance
              (AMR) in India. Developed through an industry-academia collaboration
              between Vanguard Diagnostics and Graphic Era University, Dehradun.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20 bg-[#eef3f5]">
      <div class="mx-auto w-full max-w-[1120px] px-4 md:px-6">
        <h2 class="text-2xl md:text-3xl font-bold text-center mb-12 md:mb-16">
          <span class="text-primary">VAN</span><span class="text-[#1a1a1a]"
            >SCAN Typhoid RT PCR Test</span
          >
        </h2>

        <div class="flex flex-col md:flex-row items-center gap-10 md:gap-16">
          <div class="w-full md:w-[45%] flex justify-center">
            <Image
              src={typhoidTestImage}
              alt=""
              class="w-full h-auto"
              width={400}
              height={340}
            />
          </div>

          <div
            class="w-full md:w-[55%] text-[15px] md:text-[16px] leading-relaxed text-[#1a1a1a] space-y-6"
          >
            <p>
              It is a nucleic acid-based diagnostic assay for the detection of
              Typhoid using a Patented Technology (Patent No. 355208). It uses
              DNA isolated from the whole blood of infected humans and has been
              found to be highly sensitive and specific.
            </p>
            <p>
              <span class="text-primary font-bold">VAN</span><span
                class="text-[#1a1a1a] font-bold">SCAN</span
              > Typhoid RT PCR Test will ensure the definitive and early detection
              of Typhoid fever thus facilitating the administration of the right antibiotics
              for treatment. This will contribute significantly towards slowing down
              the threat from Antimicrobial Resistance (AMR) in India.
            </p>
            <p>
              <span class="text-primary font-bold">VAN</span><span
                class="text-[#1a1a1a] font-bold">SCAN</span
              > Typhoid RT PCR Test is an Industry-Academia Collaboration between
              Vanguard Diagnostics and <a
                href="https://geu.ac.in/"
                class="text-primary font-medium hover:underline hover:text-[#005a66] transition-colors"
                target="_blank"
                rel="noopener noreferrer">Graphic Era University, Dehradun.</a
              >
            </p>
          </div>
        </div>
      </div>
    </section>

    <ProductFAQ faqs={faqs} />
  </main>
</Layout>
