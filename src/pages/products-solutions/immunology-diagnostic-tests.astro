---
import Layout from "../../layouts/Layout.astro";
import { images } from "../../data/images";

const title = "Immunology Diagnostic Tests | Vanguard Diagnostics";
const description =
  "Rapid Immunology Diagnostics Tests for Malaria, Dengue, Typhoid in the Antigen, Antibody & Combo Formats. Vanguard Diagnostics";

const rapidCardTests = [
  "Malaria pf/pv – Antigen detection test",
  "Malaria pf/pan – Antigen detection test",
  "Malaria pan – Antigen detection test",
  "Dengue – IgM/IgG – Antibody detection test",
  "Dengue – NS1 – Antigen detection test",
  "Dengue Combo NS1/IgM/IgG – Antigen & Antibody detection test",
  "Chikungunya IgM Ab test",
  "Typhoid Antigen Detection test",
  "Japanese Encephalitis Virus Ab test",
];

const elisaTests = ["HIV Gen 4", "HBsAg", "HCV", "Dengue NS1"];

const elisaProducts = [
  {
    name: "Microwell ELISA for HIV Gen 4",
    tests: "96 Tests",
  },
  {
    name: "Microwell ELISA for HBsAg",
    tests: "96 Tests",
  },
  {
    name: "Microwell ELISA for HCV",
    tests: "96 Tests",
  },
];
---

<Layout title={title} description={description}>
  <main class="bg-[#efefef] text-foreground pb-20">
    <!-- Hero Banner -->
    <section class="bg-white pt-6">
      <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster={images.heroPoster}
        class="hero-video block h-auto w-full aspect-[16/9]"
        src={images.productPageBannerVideo}
        width={1920}
        height={1080}
      >
      </video>
    </section>

    <!-- Accent bar -->
    <div class="h-[3px] bg-primary"></div>

    <!-- Main Content -->
    <section class="max-w-[1120px] mx-auto px-4 pt-16">
      <!-- Page Title -->
      <div class="flex flex-col gap-4 mb-8">
        <img
          src={images.immunology.productIcon}
          alt=""
          class="w-14 h-auto object-contain"
          width={56}
          height={56}
        />
        <h1 class="text-3xl md:text-4xl font-bold text-[#1a1a1a]">
          Immunology Diagnostic Tests
        </h1>
      </div>

      <!-- Introduction -->
      <div class="text-[15px] leading-7 text-[#4b5563] space-y-5 mb-14">
        <p>
          Vanguard Diagnostics is committed to innovation and offers an
          extensive suite of
          <strong class="text-primary">Immunology Diagnostic Tests</strong>. We
          develop and manufacture ELISA and immune chromatography tests for
          various types of infectious diseases. We were amongst the first in the
          country to make ELISA assays for the detection of antibodies to
          Covid-19.
        </p>
        <h2 class="text-[22px] font-bold text-[#1a1a1a] mb-2">
          Advanced Immunology Diagnostic Tests
        </h2>
        <p>
          Vanguard Diagnostics has several successful Industry-Academia
          collaborations to its credit with prestigious organisations such as
          DRDO and IITD. Recently Vanguard Diagnostics collaborated with Graphic
          Era University to develop and commercialize the first RT-PCR Test for
          the detection of Typhoid based on patented technology. Our objective
          at Vanguard Diagnostics is to build an Indian brand that stands for
          Quality and Reliability. For any questions or queries related to
          Immunology Diagnostic tests, please feel free to{" "}
          <a
            href="/contact-us"
            class="text-primary hover:text-[#005a66] hover:underline underline-offset-2 transition-colors"
            >talk to us.</a
          >
        </p>
      </div>

      <!-- Why are Immunology Diagnostic Tests needed? -->
      <div class="mb-14">
        <h2 class="text-[20px] font-bold text-[#1a1a1a] mb-5">
          Why are Immunology Diagnostic Tests needed?
        </h2>
        <p class="text-[15px] leading-7 text-[#4b5563] mb-5">
          Immunology Diagnostic Tests play a crucial role in our healthcare
          system, primarily because they provide insights into the complex
          interactions and functions of the immune system. Here's why they are
          indispensable:
        </p>
        <div class="text-[15px] leading-7 text-[#4b5563] space-y-4">
          <p>
            <strong class="text-black font-bold">Disease Identification:</strong
            > Many illnesses, from autoimmune diseases to allergies and infections,
            manifest due to irregularities in the immune system. These tests help
            in diagnosing such conditions.
          </p>
          <p>
            <strong class="text-black font-bold"
              >Assessment of Immune Response:</strong
            > After vaccinations or infections, it's vital to determine how well the
            body's immune system is responding. Immunology tests give a quantifiable
            measure of this response, indicating the body's ability to fend off future
            infections.
          </p>
          <p>
            <strong class="text-black font-bold">Guided Treatment Plans:</strong
            > Understanding the nuances of the immune system enables healthcare providers
            to craft individualized treatment plans. For patients with immune deficiencies
            or overactive immune responses, this customization is crucial.
          </p>
          <p>
            <strong class="text-black font-bold"
              >Blood Screening before Transfusion:</strong
            > Many diseases like Sickle Cell Disease and Thalassemia require transfusion
            of blood into the patients on a regular basis throughout life. It is imperative
            that the blood be screened for the presence of Transfusion Transmissible
            Infections (TTIs) like HIV, HBV and HCV before transfusion.
          </p>
          <p>
            Immunology tests such as ELISAs and CLIAs are very effectively used
            for the early and reliable screening of pathogens in the blood for
            transfusion in the blood banks.
          </p>
          <p>
            <strong class="text-black font-bold"
              >Transplantation Suitability:</strong
            > Before organ or tissue transplants, it's essential to ensure that the
            donor and recipient are immunologically compatible to prevent transplant
            rejection. Diagnostic tests provide this compatibility insight.
          </p>
        </div>
      </div>

      <!-- Importance of Immunology Diagnostic Tests -->
      <div class="mb-16">
        <h2 class="text-[20px] font-bold text-[#1a1a1a] mb-5">
          Importance of Immunology Diagnostic Tests
        </h2>
        <div class="text-[15px] leading-7 text-[#4b5563] space-y-4">
          <p>
            <strong class="text-black font-bold">Early Detection:</strong> Like all
            diagnostic tools, immunology tests are instrumental in early disease detection.
            Recognizing infections and immune system irregularities at an initial
            stage can lead to more effective treatments and better patient outcomes.
          </p>
          <p>
            <strong class="text-black font-bold"
              >Understanding Disease Progression:</strong
            > For chronic diseases like HIV/AIDS or autoimmune disorders, monitoring
            the immune system's activity can help understand the disease's progression
            and the effectiveness of ongoing treatments.
          </p>
          <p>
            <strong class="text-black font-bold"
              >Research &amp; Development:</strong
            > In the realm of medical research, immunology diagnostic tests are invaluable.
            They enable researchers to understand immune responses better, paving
            the way for novel treatments, vaccines, and therapeutic strategies.
          </p>
          <p>
            <strong class="text-black font-bold"
              >Public Health Decisions:</strong
            > On a broader scale, understanding the immunity levels within populations
            can guide public health decisions, especially when it comes to vaccine
            distribution or measures to prevent outbreaks.
          </p>
        </div>
      </div>

      <!-- Rapid Card Tests -->
      <div class="mb-16">
        <h2 class="text-[22px] font-bold text-primary mb-5">
          Rapid Card Tests
        </h2>

        <div class="flex flex-col lg:flex-row gap-10 items-start">
          <!-- Left: list + image -->
          <div class="flex-1">
            <p class="text-base text-[#4b5563] mb-6">
              <a
                href="/contact-us"
                class="text-primary hover:text-[#005a66] hover:underline underline-offset-2 font-medium transition-colors"
              >
                Rapid Immunology Diagnostics Tests
              </a>{" "}
              for Malaria, Dengue, Typhoid in the Antigen, Antibody &amp; Combo Formats.
            </p>

            <ul class="space-y-4">
              {
                rapidCardTests.map((test) => (
                  <li class="flex items-center gap-2 text-base text-[#4b5563]">
                    <img
                      src={images.bulletIcon}
                      alt=""
                      aria-hidden="true"
                      width={14}
                      height={14}
                    />
                    {test}
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Right: product image -->
          <div class="w-full max-w-[550px] shrink-0">
            <img
              src={images.immunology.pic1}
              alt="Rapid Card Test products – Malaria, Dengue, Chikungunya, Typhoid kits"
              class="w-full h-auto object-contain rounded-lg"
              width={550}
              height={400}
            />
          </div>
        </div>

        <!-- ELISAs sub-section -->
        <div class="mt-10">
          <h3 class="text-[18px] font-bold text-[#1a1a1a] mb-4">ELISAs</h3>
          <ul class="space-y-4">
            {
              elisaTests.map((test) => (
                <li class="flex items-center gap-2 text-base text-[#4b5563]">
                  <img
                    src={images.bulletIcon}
                    alt=""
                    aria-hidden="true"
                    width={14}
                    height={14}
                  />
                  {test}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
    <!-- ELISA Product Showcase -->
    <div class="px-4">
      <img
        src={images.immunology.pic2}
        alt="Microwell ELISA products – HIV Gen 4, HBsAg, HCV and Dengue NS1 rapid card test"
        class="w-full h-auto object-contain rounded-lg"
        width={1120}
        height={400}
      />
    </div>
  </main>
</Layout>
