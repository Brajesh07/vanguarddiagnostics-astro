---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { careerContent } from "../data/content";
import GSCareerForm from "../components/GSCareerForm";
import CareerPopupModal from "../components/CareerPopupModal.astro";
import { careerBanner, certificationIcon } from "../assets/images";

const { metadata, hero, application, openings } = careerContent;
---

<Layout title={metadata.title} description={metadata.description}>
  <main class="text-foreground">
    <!-- Hero banner -->
    <section class="border-b-[3px] border-primary">
      <Image
        alt={hero.alt}
        class="h-auto w-full object-cover"
        src={careerBanner}
        width={1920}
        height={900}
      />
    </section>

    <!-- Application form -->
    <section class="bg-[#efefef] py-10 md:py-14 text-left">
      <div class="mx-auto w-full max-w-[760px] px-4 md:px-6">
        <p
          class="text-base leading-7 text-[#555555]"
          set:html={application.p1}
        />
        <p
          class="mt-4 text-base leading-7 text-[#555555]"
          set:html={application.p2}
        />

        <Image
          alt="Career figure"
          class="mt-6 h-[100px] w-auto"
          src={certificationIcon}
          width={135}
          height={128}
        />
        <GSCareerForm client:load fields={application.fields} />
      </div>
    </section>

    <!-- Open Positions -->
    <section class="bg-[#f5f5f5] py-10 md:py-14 text-left">
      <div class="mx-auto w-full max-w-[1120px] px-4 md:px-6">
        <h2
          class="text-[28px] font-semibold text-[#3a3a3a] md:text-[32px] text-left"
        >
          Current <span class="text-primary">Open Positions</span>
        </h2>

        <div class="mt-8 grid gap-4 grid-cols-1 sm:grid-cols-2 md:grid-cols-4">
          {
            openings.popup.map((item, idx) => {
              const popupId = `career-popup-${idx}`;
              const openBtnId = `open-career-popup-${idx}`;
              return (
                <>
                  <div
                    id={openBtnId}
                    class="cursor-pointer group flex flex-col items-center justify-center gap-4 border-b-4 border-b-primary bg-white p-5 text-center shadow-[0_3px_10px_rgba(0,0,0,0.08)] transition-all hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(0,0,0,0.12)] min-h-36"
                  >
                    {item.heading}
                  </div>
                  <CareerPopupModal
                    popupId={popupId}
                    openBtnId={openBtnId}
                    heading={item.heading}
                    items={item.para}
                  />
                </>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
</Layout>
