---
import Layout from "../layouts/Layout.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import BulletList from "../components/ui/BulletList.astro";
import { Image } from "astro:assets";
import { qualityContent } from "../data/content";
import {
  qualityIcon,
  qualityBanner,
  qualityFooter1,
  qualityFooter2,
  qualityFooter3,
} from "../assets/images";

const { metadata, intro, norms, insights } = qualityContent;
---

<Layout title={metadata.title} description={metadata.description}>
  <main class="bg-[#efefef] text-foreground">
    <section>
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/hero-poster.webp"
        class="hero-video w-full h-full object-cover"
        src="/images/vanguard/products-solutions/Vanguard-Quality-banner-new.mp4"
        width={1920}
        height={1080}
      >
      </video>
    </section>

    <!-- Quality intro + image -->
    <section class="border-t-2 border-primary bg-[#efefef] py-10">
      <div
        class="mx-auto grid w-full max-w-[1120px] gap-7 px-4 md:grid-cols-[1fr_430px] md:items-start md:px-6"
      >
        <article>
          <Image
            alt="Quality icon"
            class="h-[68px] w-auto"
            src={qualityIcon}
            width={114}
            height={135}
          />
          <SectionHeading class="mt-2">{intro.title}</SectionHeading>
          <p class="mt-4 text-[15px] leading-7 text-[#555555]">
            {intro.description}
          </p>
          <BulletList class="mt-5" items={intro.checks} />
        </article>
        <Image
          alt="Quality checks"
          class="h-auto w-full object-cover"
          src={qualityBanner}
          width={455}
          height={300}
        />
      </div>
    </section>

    <!-- Quality norms -->
    <section class="bg-white py-10">
      <div class="mx-auto w-full max-w-[1120px] px-4 md:px-6">
        <h2
          class="text-[34px] font-semibold leading-tight text-[#3a3a3a] md:max-w-[920px]"
        >
          {norms.title}
        </h2>
        <BulletList class="mt-6" items={norms.items} />
      </div>
    </section>

    <!-- Quality insights cards -->
    <section class="bg-[#efefef] py-10">
      <div
        class="mx-auto grid w-full max-w-[1120px] gap-6 px-4 md:grid-cols-3 md:px-6"
      >
        {
          [
            {
              title: insights[0].title,
              body: insights[0].body,
              img: qualityFooter1,
              width: 630,
              height: 387,
            },
            {
              title: insights[1].title,
              body: insights[1].body,
              img: qualityFooter2,
              width: 630,
              height: 387,
            },
            {
              title: insights[2].title,
              body: insights[2].body,
              img: qualityFooter3,
              width: 630,
              height: 387,
            },
          ].map((item) => (
            <article class="bg-white">
              <Image
                alt={item.title}
                class="h-auto w-full object-cover"
                src={item.img}
                width={item.width}
                height={item.height}
              />
              <p class="px-4 py-4 text-base leading-6 text-[#555555]">
                <strong>{item.title}</strong> {item.body}
              </p>
            </article>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
