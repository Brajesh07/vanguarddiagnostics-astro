---
import Layout from "../layouts/Layout.astro";
import BulletList from "../components/ui/BulletList.astro";
import VanguardButton from "../components/ui/VanguardButton.astro";
import ContentWithImage from "../components/ui/ContentWithImage.astro";
import { aboutContent } from "../data/content";
import { images } from "../data/images";

const {
  metadata,
  hero,
  philosophy,
  team,
  model,
  sections,
  ivdIndustry,
  servingBanner,
} = aboutContent;

const BASE_URL = "https://vanguarddiagnostics.com";

const pageSchema = [
  ...team.map((member) => ({
    "@context": "https://schema.org",
    "@type": "Person",
    name: member.name,
    jobTitle: member.role,
    image: `${BASE_URL}${member.image}`,
    worksFor: {
      "@id": `${BASE_URL}/#organization`,
    },
  })),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${BASE_URL}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "About Us",
        item: `${BASE_URL}/about-us`,
      },
    ],
  },
];
---

<Layout
  title={metadata.title}
  description={metadata.description}
  pageSchema={pageSchema}
>
  <main class="bg-[#ffffff] text-foreground">
    <!-- Banner -->
    <section class="py-7">
      <div class="mx-auto w-full max-w-[1120px] px-4 md:px-6">
        <img
          alt="About us banner"
          class="h-auto w-full object-cover"
          src={hero.banner}
          width={1120}
          height={400}
          fetchpriority="high"
        />
      </div>
    </section>

    <!-- About intro -->
    <section class="relative border-t-2 border-primary pb-10 pt-8">
      <img
        class="absolute top-0 right-0 z-0 object-cover h-auto w-[400px]"
        src={images.about.bg}
        alt=""
        width={400}
        height={400}
        loading="lazy"
      />
      <div
        class="mx-auto flex w-full max-w-[1120px] gap-8 px-4 flex-col md:px-6"
      >
        <img
          alt="about icon"
          class="h-auto w-20 object-contain"
          src={hero.icon}
          width={80}
          height={80}
          loading="lazy"
        />
        <article class="flex flex-col gap-4">
          <h1 class="text-2xl font-medium">
            {hero.title.split("Vanguard")[0]}
            <span class="text-primary">Vanguard Diagnostics</span>
          </h1>
          <p class="mb-2 leading-[1.5] text-black text-base">
            {hero.definition}
          </p>
          <p class="mb-2 leading-[1.5] text-black text-base">
            {hero.p1}
          </p>
          <p class="mb-2 leading-[1.5] text-black text-base">
            {hero.p2}
          </p>
          <VanguardButton
            href="#"
            variant="outline"
            class="px-5 py-2 text-sm w-fit"
            data-about-popup-trigger="true"
            aria-label="Read more about Vanguard Diagnostics"
          >
            {hero.cta.text}
          </VanguardButton>
        </article>
        <div class="hidden md:block"></div>
      </div>
    </section>

    <!-- Team heading -->
    <section id="Team" class="py-2">
      <div class="mx-auto w-full max-w-[1120px] px-4 text-center md:px-6">
        <img
          alt="Team icon"
          class="mx-auto h-[82px] w-auto"
          src={philosophy.icon}
          width={82}
          height={82}
          loading="lazy"
        />
        <h2 class="mt-2 text-[30px] font-medium text-black">
          Our <span class="text-primary">Team</span>
        </h2>
      </div>
    </section>

    <!-- Team members -->
    <section class="pb-7">
      <div
        class="mx-auto flex w-full max-w-[1120px] flex-col gap-7 px-4 md:px-6"
      >
        {
          team.map((member) => (
            <article class="border-t-2 border-primary bg-white px-4 py-4 flex flex-col md:flex-row md:gap-5">
              <div class="flex flex-col gap-1 items-center justify-center w-full max-w-full md:max-w-[322px]">
                <img
                  alt={member.name}
                  class="h-auto max-w-full md:max-w-[322px] object-cover"
                  src={member.image}
                  width={322}
                  height={400}
                  loading="lazy"
                />
                <h3 class="text-[22px] font-semibold text-primary">
                  {member.name}
                </h3>
                <p class="text-base font-semibold text-[#333333]">
                  {member.role}
                </p>
              </div>

              <div class="mt-3 md:mt-0">
                <p
                  class="mt-2 text-base leading-6 text-[#555555]"
                  set:html={member.bio}
                />
                {member.hasPopup ? (
                  <button
                    class="mt-3 inline-flex items-center justify-center rounded border border-primary px-5 py-2 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-white focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
                    data-team-popup-trigger={member.id}
                  >
                    Read More
                  </button>
                ) : null}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Our Model -->
    <section class="py-7">
      <div class="mx-auto w-full max-w-[1120px] px-4 md:px-6">
        <h2 class="text-[30px] font-medium text-black">
          Our <span class="text-primary">Model</span>
        </h2>
        <BulletList class="mt-4" items={model.bullets} />
      </div>
    </section>

    <!-- Dynamic Content Sections -->
    {
      sections.map((section, index) => (
        <ContentWithImage
          {...section}
          imagePosition={index % 2 === 0 ? "right" : "left"}
        />
      ))
    }

    <!-- Serving banner -->
    <section class="pt-8">
      <img
        alt="Serving you well"
        class="mx-auto h-auto w-full object-cover"
        src={servingBanner}
        width={1120}
        height={300}
      />
    </section>
  </main>

  <!-- Industry Popup Dialog -->
  <div
    data-industry-popup-overlay
    class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/60 opacity-0 pointer-events-none transition-opacity duration-300"
    aria-modal="true"
    role="dialog"
    aria-labelledby="industry-popup-heading"
  >
    <div
      data-industry-popup-box
      class="relative w-full max-w-[800px] h-auto min-h-[500px] mx-4 overflow-hidden rounded-sm shadow-2xl p-8 md:p-12 flex items-center"
      style={`background-image: url('${ivdIndustry.popup.bg}'); background-size: cover; background-position: center; background-repeat: no-repeat;`}
    >
      <!-- Close button -->
      <button
        data-industry-popup-close
        aria-label="Close popup"
        class="absolute top-4 right-4 z-10 flex h-9 w-9 items-center justify-center text-black"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div>
        <h2
          id="industry-popup-heading"
          class="text-[28px] md:text-[35px] font-semibold leading-[1.3] text-[#00A4B2] mb-6"
        >
          {ivdIndustry.popup.title.split("Industry")[0]}
          <em>in-vitro</em> Diagnostics Industry {
            ivdIndustry.popup.title.split("Diagnostics Industry")[1]
          }
        </h2>
        <div style={{ background: "red", width: 500, height: 500 }}></div>
        <div
          class="text-[16px] font-semibold leading-[1.5] text-black text-left"
        >
          {
            ivdIndustry.popup.paragraphs.map((p, i) => (
              <p
                class={
                  i < ivdIndustry.popup.paragraphs.length - 1
                    ? "mb-[1.75em]"
                    : ""
                }
              >
                {p}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- About Popup Dialog -->
  <div
    data-about-popup-overlay
    class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/60 opacity-0 pointer-events-none transition-opacity duration-300"
    aria-modal="true"
    role="dialog"
    aria-labelledby="about-popup-heading"
  >
    <div
      data-about-popup-box
      class="relative w-full max-w-[800px] h-auto min-h-[500px] mx-4 overflow-hidden rounded-sm shadow-2xl p-8 md:p-12 flex items-center"
      style={`background-image: url('${hero.popup.bg}'); background-size: cover; background-position: center; background-repeat: no-repeat;`}
    >
      <!-- Close button -->
      <button
        data-about-popup-close
        aria-label="Close popup"
        class="absolute top-4 right-4 z-10 flex h-9 w-9 items-center justify-center text-black"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div>
        <h2
          id="about-popup-heading"
          class="text-[28px] md:text-[35px] font-semibold leading-[1.3] text-[#00A4B2] mb-6"
        >
          {hero.popup.title}
        </h2>
        <div
          class="text-[16px] font-semibold leading-[1.5] text-black text-justify"
        >
          {
            hero.popup.paragraphs.map((p, i) => (
              <p
                class={
                  i < hero.popup.paragraphs.length - 1 ? "mb-[1.75em]" : ""
                }
              >
                {p}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <!-- Team Popup Dialog -->
  <div
    data-team-popup-overlay
    class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/60 opacity-0 pointer-events-none transition-opacity duration-300"
    aria-modal="true"
    role="dialog"
    aria-label="Team Member Details"
  >
    <div
      data-team-popup-box
      class="relative w-full max-w-[700px] bg-white mx-4 overflow-hidden rounded-sm shadow-2xl max-h-[90vh] overflow-y-auto"
    >
      <!-- Close button -->
      <button
        data-team-popup-close
        aria-label="Close popup"
        class="absolute top-4 right-4 z-10 flex h-9 w-9 items-center justify-center text-gray-500 hover:text-black transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div id="team-popup-content">
        {
          team
            .filter((m) => m.hasPopup)
            .map((member) => (
              <div data-team-popup-id={member.id} class="hidden">
                <h2 id={`team-heading-${member.id}`} class="text-[28px] md:text-[34px] font-semibold text-primary mb-6 p-4 bg-[#e5e9ef]">
                  {member.name}
                </h2>
                <div
                  class="text-base leading-7 text-gray-700 p-4"
                  set:html={member.extraBio}
                />
              </div>
            ))
        }
      </div>
    </div>
  </div>

  <script>
    // --- UTILS ---
    function togglePopup(overlay: HTMLElement | null, show: boolean) {
      if (!overlay) return;
      if (show) {
        overlay.classList.remove("opacity-0", "pointer-events-none");
        overlay.classList.add("opacity-100");
        document.body.style.overflow = "hidden";
      } else {
        overlay.classList.add("opacity-0", "pointer-events-none");
        overlay.classList.remove("opacity-100");
        document.body.style.overflow = "";
        if (overlay.hasAttribute("data-team-popup-overlay")) {
          overlay.removeAttribute("aria-labelledby");
        }
      }
    }

    // --- TEAM POPUP ---
    const teamOverlay = document.querySelector(
      "[data-team-popup-overlay]",
    ) as HTMLElement;
    const teamPopupBox = document.querySelector(
      "[data-team-popup-box]",
    ) as HTMLElement;
    const teamCloseBtn = document.querySelector("[data-team-popup-close]");

    function openTeamPopup(memberId: string) {
      document.querySelectorAll("[data-team-popup-id]").forEach((panel) => {
        panel.classList.add("hidden");
      });
      const active = document.querySelector(
        `[data-team-popup-id="${memberId}"]`,
      );
      active?.classList.remove("hidden");
      teamOverlay.setAttribute("aria-labelledby", `team-heading-${memberId}`);
      togglePopup(teamOverlay, true);
    }

    document.querySelectorAll("[data-team-popup-trigger]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const memberId = (btn as HTMLElement).dataset.teamPopupTrigger ?? "";
        openTeamPopup(memberId);
      });
    });

    teamCloseBtn?.addEventListener("click", () =>
      togglePopup(teamOverlay, false),
    );
    teamOverlay?.addEventListener("click", (e) => {
      if (teamPopupBox && !teamPopupBox.contains(e.target as Node)) {
        togglePopup(teamOverlay, false);
      }
    });

    // --- INDUSTRY POPUP ---
    const industryOverlay = document.querySelector(
      "[data-industry-popup-overlay]",
    ) as HTMLElement;
    const industryPopupBox = document.querySelector(
      "[data-industry-popup-box]",
    ) as HTMLElement;
    const industryCloseBtn = document.querySelector(
      "[data-industry-popup-close]",
    );
    const industryTriggers = document.querySelectorAll(
      "[data-industry-popup-trigger]",
    );

    industryTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () =>
        togglePopup(industryOverlay, true),
      );
    });

    industryCloseBtn?.addEventListener("click", () =>
      togglePopup(industryOverlay, false),
    );
    industryOverlay?.addEventListener("click", (e) => {
      if (industryPopupBox && !industryPopupBox.contains(e.target as Node)) {
        togglePopup(industryOverlay, false);
      }
    });

    // --- ABOUT POPUP ---
    const aboutOverlay = document.querySelector(
      "[data-about-popup-overlay]",
    ) as HTMLElement;
    const aboutPopupBox = document.querySelector(
      "[data-about-popup-box]",
    ) as HTMLElement;
    const aboutCloseBtn = document.querySelector("[data-about-popup-close]");
    const aboutTriggers = document.querySelectorAll(
      "[data-about-popup-trigger]",
    );

    aboutTriggers.forEach((trigger) => {
      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        togglePopup(aboutOverlay, true);
      });
    });

    aboutCloseBtn?.addEventListener("click", () =>
      togglePopup(aboutOverlay, false),
    );
    aboutOverlay?.addEventListener("click", (e) => {
      if (aboutPopupBox && !aboutPopupBox.contains(e.target as Node)) {
        togglePopup(aboutOverlay, false);
      }
    });

    // --- GLOBAL ---
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        togglePopup(teamOverlay, false);
        togglePopup(industryOverlay, false);
        togglePopup(aboutOverlay, false);
      }
    });
  </script>
</Layout>
