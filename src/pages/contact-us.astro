---
import Layout from '../layouts/Layout.astro';
import { contactContent } from '../data/content';

const { hero, getInTouch, addressSection } = contactContent;
---

<Layout
  title="Contact Us | Vanguard Diagnostics"
  description="Get in touch with Vanguard Diagnostics. Contact us at our facility in Noida."
>
  <main class="bg-[#e9e9e9] text-foreground">

    <!-- Banner -->
    <section class="pb-8 pt-4 text-center md:pb-10">
      <div class="mx-auto w-full max-w-[1120px] px-4 md:px-6">
        <img
          alt="Contact banner"
          class="mx-auto h-auto w-full max-w-[700px] object-contain"
          src={hero.image}
        />
        <h1 class="mt-2 text-[44px] font-semibold tracking-tight">
          <span class="text-primary">{hero.title.split(' ')[0]}</span>{" "}
          <span class="text-black">{hero.title.split(' ')[1]}</span>
        </h1>
      </div>
    </section>

    <!-- Get In Touch + Map -->
    <section class="border-t-4 border-primary py-10 md:py-14">
      <div class="mx-auto w-full max-w-[760px] px-4">
        <div class="text-center">
          <img
            alt="Get In Touch icon"
            class="mx-auto h-[76px] w-auto"
            src={getInTouch.icon}
          />
          <h2 class="mt-2 text-[52px] font-semibold leading-none">
            <span class="text-black">{getInTouch.title.split(' ').slice(0, 2).join(' ')}</span>{" "}
            <span class="text-primary">{getInTouch.title.split(' ').slice(2).join(' ')}</span>
          </h2>
        </div>

        <!-- TODO: wire up form submission -->
        <form class="mt-7 space-y-4">
          <label class="block">
            <span class="mb-1 block text-left text-[12px] text-foreground">{getInTouch.form.nameLabel}</span>
            <input
              class="h-[36px] w-full border border-[#d4d4d4] bg-[#f4f4f4] px-3 text-[13px] text-[#333333] outline-none focus:border-primary"
              type="text"
            />
          </label>

          <div class="grid gap-4 md:grid-cols-2">
            <label class="block">
              <span class="mb-1 block text-left text-[12px] text-foreground">{getInTouch.form.emailLabel}</span>
              <input
                class="h-[36px] w-full border border-[#d4d4d4] bg-[#f4f4f4] px-3 text-[13px] text-[#333333] outline-none focus:border-primary"
                type="email"
              />
            </label>

            <label class="block">
              <span class="mb-1 block text-left text-[12px] text-foreground">{getInTouch.form.phoneLabel}</span>
              <input
                class="h-[36px] w-full border border-[#d4d4d4] bg-[#f4f4f4] px-3 text-[13px] text-[#333333] outline-none focus:border-primary"
                type="tel"
              />
            </label>
          </div>

          <label class="block">
            <span class="mb-1 block text-left text-[12px] text-foreground">{getInTouch.form.messageLabel}</span>
            <textarea class="min-h-[88px] w-full border border-[#d4d4d4] bg-[#f4f4f4] px-3 py-2 text-[13px] text-[#333333] outline-none focus:border-primary" />
          </label>

          <div class="text-left">
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded bg-primary px-4 py-2 text-[12px] font-medium text-white transition-colors hover:bg-[#017d8c]"
            >
              {getInTouch.form.buttonText}
            </button>
          </div>
        </form>
      </div>

      <!-- Map + Address -->
      <div class="mx-auto mt-16 grid w-full max-w-[760px] gap-4 px-4 md:grid-cols-[1fr_280px] md:items-start">
        <iframe
          class="h-[210px] w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src={addressSection.mapUrl}
          title="Vanguard Diagnostics Location"
        />

        <aside>
          <div class="flex items-center gap-2">
            <img
              alt="Location icon"
              class="h-[46px] w-[46px]"
              src={addressSection.icon}
            />
            <h3 class="text-[42px] font-medium leading-none tracking-tight">
              <span class="text-black">{addressSection.title.split(' ')[0]}</span>{" "}
              <span class="text-primary">{addressSection.title.split(' ')[1]}</span>
            </h3>
          </div>

          <img
            alt="Divider"
            class="mt-2 h-[8px] w-[66px] object-cover"
            src={addressSection.divider}
          />

          <div class="mt-3 space-y-1 text-[12px] leading-6 text-[#555555]">
            <p>{addressSection.address}</p>
            <p>
              <a class="hover:text-primary" href={addressSection.phoneLink}>
                {addressSection.phone}
              </a>
            </p>
            <p>
              <a class="hover:text-primary" href={addressSection.emailLink}>
                {addressSection.email}
              </a>
            </p>
          </div>
        </aside>
      </div>
    </section>

  </main>
</Layout>
