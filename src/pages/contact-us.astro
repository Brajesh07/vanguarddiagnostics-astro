---
import Layout from "../layouts/Layout.astro";
import { contactContent } from "../data/content";
// import ContactForm from "../components/ContactForm";
import GSContactForm from "../components/GSContactForm";

const { metadata, hero, getInTouch, addressSection } = contactContent;

const BASE_URL = "https://vanguarddiagnostics.com";

const pageSchema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Contact Vanguard Diagnostics",
    "url": `${BASE_URL}/contact-us`,
    "mainEntity": {
      "@id": `${BASE_URL}/#organization`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": `${BASE_URL}/`,
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Contact Us",
        "item": `${BASE_URL}/contact-us`,
      },
    ],
  },
];
---

<Layout
  title={metadata.title}
  description={metadata.description}
  pageSchema={pageSchema}
>
  <main class="bg-[#efeeef] text-foreground">
    <!-- Banner -->
    <section class="w-full">
      <img
        alt="Contact banner"
        class="h-auto w-full object-contain"
        src={hero.image}
      />
    </section>

    <!-- Get In Touch + Map -->
    <section class="border-t-4 border-primary py-10 md:py-14">
      <div class="mx-auto w-full max-w-[760px] px-4">
        <div class="text-center">
          <img
            alt="Get In Touch icon"
            class="mx-auto h-[76px] w-auto"
            src={getInTouch.icon}
          />
          <h2 class="mt-2 text-[52px] font-semibold leading-none">
            <span class="text-black"
              >{getInTouch.title.split(" ").slice(0, 2).join(" ")}</span
            >{" "}
            <span class="text-primary"
              >{getInTouch.title.split(" ").slice(2).join(" ")}</span
            >
          </h2>
        </div>

        {/* <ContactForm
          client:load
          nameLabel={getInTouch.form.nameLabel}
          emailLabel={getInTouch.form.emailLabel}
          phoneLabel={getInTouch.form.phoneLabel}
          messageLabel={getInTouch.form.messageLabel}
          buttonText={getInTouch.form.buttonText}
        /> */}
        <GSContactForm
          client:load
          nameLabel={getInTouch.form.nameLabel}
          emailLabel={getInTouch.form.emailLabel}
          phoneLabel={getInTouch.form.phoneLabel}
          messageLabel={getInTouch.form.messageLabel}
          buttonText={getInTouch.form.buttonText}
        />
      </div>

      <!-- Map + Address -->
      <div
        class="mx-auto mt-16 grid w-full max-w-[760px] gap-4 px-4 md:grid-cols-[1fr_280px] md:items-start"
      >
        <iframe
          class="h-[210px] w-full border-0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          src={addressSection.mapUrl}
          title="Vanguard Diagnostics Location"></iframe>

        <aside>
          <div class="flex items-center gap-2">
            <img
              alt="Location icon"
              class="h-[46px] w-[46px]"
              src={addressSection.icon}
            />
            <h3 class="text-[42px] font-medium leading-none tracking-tight">
              <span class="text-black"
                >{addressSection.title.split(" ")[0]}</span
              >{" "}
              <span class="text-primary"
                >{addressSection.title.split(" ")[1]}</span
              >
            </h3>
          </div>

          <img
            alt="Divider"
            class="mt-2 h-[8px] w-[66px] object-cover"
            src={addressSection.divider}
          />

          <div class="mt-3 space-y-1 text-[12px] leading-6 text-[#555555]">
            <p>{addressSection.address}</p>
            <p>
              <a class="hover:text-primary" href={addressSection.phoneLink}>
                {addressSection.phone}
              </a>
            </p>
            <p>
              <a class="hover:text-primary" href={addressSection.emailLink}>
                {addressSection.email}
              </a>
            </p>
          </div>
        </aside>
      </div>
    </section>
  </main>
</Layout>
