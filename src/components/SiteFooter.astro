---
import { siteData } from '../data/site';
import { footerContent } from '../data/content';
---

<footer class="bg-[#333132] text-white">
  <div class="mx-auto grid w-full max-w-[1120px] gap-8 px-4 py-10 md:grid-cols-3 md:px-6">
    <!-- Left: links + social icons -->
    <div>
      <a class="block text-[14px] text-white/90 hover:text-white" href="/about-us">
        About Us
      </a>
      <a class="mt-2 block text-[14px] text-white/90 hover:text-white" href="/privacy-policy">
        Privacy Policy
      </a>
      <a class="mt-2 block text-[14px] text-white/90 hover:text-white" href="/terms-and-conditions">
        Terms &amp; Condition
      </a>
      <div class="mt-5 flex items-center gap-2">
        <!-- YouTube -->
        <a
          aria-label="YouTube"
          class="flex h-8 w-9 items-center justify-center rounded-sm bg-[#cd201f] hover:opacity-90"
          href={siteData.youtube}
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg fill="white" height="14" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg">
            <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.75 15.5V8.5l6.25 3.5-6.25 3.5z" />
          </svg>
        </a>
        <!-- Twitter -->
        <a
          aria-label="Twitter"
          class="flex h-8 w-8 items-center justify-center rounded-full bg-[#1da1f2] hover:opacity-90"
          href="https://twitter.com/VanguardDiag"
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg fill="white" height="14" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
            <path d="M23.95 4.57a10 10 0 0 1-2.82.77 4.96 4.96 0 0 0 2.16-2.72c-.95.56-2 .96-3.12 1.19a4.92 4.92 0 0 0-8.38 4.49A13.96 13.96 0 0 1 1.64 3.16a4.92 4.92 0 0 0 1.52 6.57 4.9 4.9 0 0 1-2.23-.61v.06a4.92 4.92 0 0 0 3.95 4.83 4.94 4.94 0 0 1-2.22.08 4.93 4.93 0 0 0 4.6 3.42A9.87 9.87 0 0 1 0 19.54a13.94 13.94 0 0 0 7.55 2.21c9.06 0 14.01-7.5 14.01-14.01 0-.21 0-.42-.02-.63A10 10 0 0 0 24 4.59l-.05-.02z" />
          </svg>
        </a>
        <!-- LinkedIn -->
        <a
          aria-label="LinkedIn"
          class="flex h-8 w-8 items-center justify-center rounded-full bg-[#0077b5] hover:opacity-90"
          href={siteData.linkedin}
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg fill="white" height="14" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0z" />
          </svg>
        </a>
        <!-- Facebook -->
        <a
          aria-label="Facebook"
          class="flex h-8 w-8 items-center justify-center rounded-full bg-[#3b5998] hover:opacity-90"
          href="https://www.facebook.com/vanguarddiagnosticsindia"
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg fill="white" height="14" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
            <path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.41 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.1 24 18.1 24 12.07z" />
          </svg>
        </a>
        <!-- Instagram -->
        <a
          aria-label="Instagram"
          class="flex h-8 w-8 items-center justify-center rounded-full bg-[#c13584] hover:opacity-90"
          href="https://www.instagram.com/vanguarddiagnostics"
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg fill="white" height="14" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85 0 3.2-.01 3.58-.07 4.85-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07-3.2 0-3.58-.01-4.85-.07-3.26-.15-4.77-1.7-4.92-4.92C2.17 15.58 2.16 15.2 2.16 12c0-3.2.01-3.58.07-4.85C2.38 3.86 3.9 2.31 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.7.07 7.05.01 8.33 0 8.74 0 12c0 3.26.01 3.67.07 4.95.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24c3.26 0 3.67-.01 4.95-.07 4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95 0-3.26-.01-3.67-.07-4.95C23.73 2.71 21.31.27 16.95.07 15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32A6.16 6.16 0 0 0 12 5.84zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Center: Connect With Us + large LinkedIn box -->
    <div class="flex flex-col items-center">
      <h4 class="text-[15px] font-semibold tracking-wide">Connect With Us</h4>
      <a
        aria-label="LinkedIn"
        class="mt-4 flex h-[72px] w-[72px] items-center justify-center rounded-md bg-[#0077b5] hover:opacity-90"
        href={siteData.linkedin}
        rel="noopener noreferrer"
        target="_blank"
      >
        <svg fill="white" height="40" viewBox="0 0 24 24" width="40" xmlns="http://www.w3.org/2000/svg">
          <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0z" />
        </svg>
      </a>
    </div>

    <!-- Right: Contact Details -->
    <div>
      <h4 class="text-[15px] font-semibold tracking-wide">Contact Details</h4>
      <div class="mt-3 flex items-start gap-2">
        <svg class="mt-0.5 h-4 w-4 shrink-0 text-white/70" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" />
        </svg>
        <p class="text-[13px] leading-[1.6] text-white/80">{footerContent.address}</p>
      </div>
      <div class="mt-3 flex items-center gap-2">
        <svg class="h-4 w-4 shrink-0 text-white/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.62 3.38 2 2 0 0 1 3.59 1.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.73a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <a href={footerContent.phoneLink} class="text-[13px] text-white/80 hover:text-white transition-colors">{footerContent.phone}</a>
      </div>
      <div class="mt-3 flex items-center gap-2">
        <svg class="h-4 w-4 shrink-0 text-white/70" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
          <polyline points="22,6 12,13 2,6" />
        </svg>
        <a href={footerContent.emailLink} class="text-[13px] text-white/80 hover:text-white transition-colors">{footerContent.email}</a>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10 bg-[#262324] px-4 py-4 md:px-6">
    <div class="mx-auto flex w-full max-w-[1120px] items-center justify-between">
      <p class="text-[12px] text-white/70">Copyright &copy; 2021 Vanguard Diagnostics</p>
      <p class="text-[12px] text-white/70">Designed By Provident Ventures</p>
    </div>
  </div>
</footer>
