---
import PDFFlipbookViewer from "./PDFFlipbookViewer.jsx";

interface Props {
  pdfUrl: string;
  pageWidth?: number;
  pageHeight?: number;
}

const {
  pdfUrl,
  pageWidth = 450,
  pageHeight = 630,
} = Astro.props;
---

<section class="pdf-flipbook-section py-16 bg-[#ffffff] overflow-x-hidden">
  <div class="container mx-auto px-4">
    <PDFFlipbookViewer
      client:only="react"
      pdfUrl={pdfUrl}
      pageWidth={pageWidth}
      pageHeight={pageHeight}
      isPopup={false}
    />
  </div>
</section>
