---
import { homeContent } from "../../data/content";
import { YouTube } from "@astro-community/astro-embed-youtube";
import { images } from "../../data/images";

const { about } = homeContent;
const { cards } = about;

const popupData = cards
  .filter((card) => card.popupHeading)
  .map((card) => ({
    id: card.id,
    heading: card.popupHeading,
    para: card.popupPara,
  }));
---

<!-- About section -->
<section class="py-12 md:py-14" id="Vision">
  <div
    class="vanguard-shell grid gap-8 md:grid-cols-[448px_1fr] md:items-start"
  >
    <div class="border-l-[3px] border-l-primary pl-3">
      <div class="w-full overflow-hidden border border-[#d6dce0] bg-black">
        <YouTube id={about.youtubeId} title="Vanguard coverage" />
      </div>
    </div>

    <article class="max-w-[640px]">
      <p class="font-sans text-[20px] font-medium leading-[1.2] text-black">
        {about.subtitle}
      </p>
      <p class="text-3xl font-medium leading-[1.2] text-black">
        {about.title.split(" ")[0]}
        <span class="ml-2 text-primary">{about.title.split(" ")[1]}</span>
      </p>
      <p class="mt-3 text-[16px] leading-[1.65] text-muted-foreground">
        {about.definitionTitle}
      </p>
      <p class="mt-2 text-[16px] leading-[1.65] text-muted-foreground">
        {about.definitionBody}
      </p>
      <p class="mt-2 text-[16px] leading-[1.65] text-muted-foreground">
        {about.p1}
      </p>
      <p class="mt-2 text-[16px] leading-[1.65] text-muted-foreground">
        {about.p2}
      </p>
      <a
        href={about.cta.href}
        target={about.cta.href === "#" ? undefined : "_blank"}
        rel={about.cta.href === "#" ? undefined : "noopener noreferrer"}
        class="mt-5 inline-flex items-center justify-center rounded border border-primary px-6 py-3 font-semibold text-primary transition-colors hover:bg-primary hover:text-white"
      >
        {about.cta.text}
      </a>
    </article>
  </div>
</section>

<!-- Awards mid section -->
<section class="pb-10 md:pb-14" id="Mission">
  <div class="vanguard-shell grid gap-4 md:grid-cols-2">
    <img
      alt="ET Now award"
      class="w-full object-contain h-full"
      src={about.awardsSection.image}
    />
    <div>
      <p class="font-sans text-base font-medium leading-[1.2] text-primary">
        {about.awardsSection.title}
      </p>
      <YouTube id={about.awardsSection.youtubeId} title="Vanguard award" />
    </div>
  </div>
</section>

<!-- Cards section -->
<section class="pb-14 hidden md:block md:pb-18" id="Team">
  <div class="vanguard-shell grid gap-4 md:grid-cols-2">
    {
      cards.slice(0, 2).map((card) => (
        <button
          class="group relative block h-[260px] overflow-hidden md:h-[320px] cursor-pointer w-full text-left"
          data-card-id={card.id}
          aria-label={`Open ${card.title} popup`}
        >
          <div
            class="absolute inset-0 bg-cover bg-center transition-transform duration-[1500ms] ease-out group-hover:scale-[1.2] z-[0]"
            style={`background-image: url(${card.image})`}
          />
          <div class="absolute w-full bg-gradient-to-b from-[#025766]/0 to-[#025766] h-[30%] bottom-0 z-10" />
          <div class="relative z-20 flex h-full items-end p-6 transition-transform duration-300 group-hover:translate-y-[-10px]">
            <p class="text-[30px] font-semibold text-white md:text-[36px]">
              {card.title}
            </p>
          </div>
        </button>
      ))
    }

    <a
      href={cards[2].href}
      class="group relative block h-[310px] overflow-hidden md:col-span-2 md:h-[460px] cursor-pointer w-full text-left"
      aria-label={`Go to ${cards[2].title}`}
    >
      <div
        class="absolute inset-0 bg-cover bg-center transition-transform duration-[1500ms] ease-out group-hover:scale-[1.2]"
        style={`background-image: url(${cards[2].image})`}
      >
      </div>
      <div
        class="absolute w-full bg-gradient-to-b from-[#025766]/0 to-[#025766] h-[30%] bottom-0 z-10"
      >
      </div>
      <div
        class="relative z-20 flex h-full items-end p-6 transition-transform duration-300 group-hover:translate-y-[-10px]"
      >
        <p class="text-[30px] font-semibold text-white md:text-[36px]">
          {cards[2].title}
        </p>
      </div>
    </a>
  </div>
</section>

<!-- Card Popup Dialog -->
<div
  data-popup-overlay
  class="fixed inset-0 z-[9999] flex items-center justify-center bg-black/60 opacity-0 pointer-events-none transition-opacity duration-300"
  aria-modal="true"
  role="dialog"
  aria-labelledby="popup-heading"
>
  <div
    data-popup-box
    class="relative w-full max-w-[800px] h-[500px] mx-4 overflow-hidden rounded-sm shadow-2xl"
    style={`background-image: url('${images.homePopupBg}'); background-size: cover; background-position: center; background-repeat: no-repeat;`}
  >
    <!-- Close button -->
    <button
      data-popup-close
      aria-label="Close popup"
      class="absolute top-4 right-4 z-10 flex h-9 w-9 items-center justify-center"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Inner content: all panels rendered statically, shown/hidden via JS -->
    <div class="p-8 md:p-12 h-full">
      {
        popupData.map((item) => (
          <div
            data-popup-id={item.id}
            class="hidden flex flex-col md:flex-row justify-center items-center gap-16 h-full"
          >
            <h2
              id="popup-heading"
              class="text-[36px] md:text-[55px] font-semibold leading-[1.3] text-[#00A4B2]"
              set:html={item.heading}
            />
            <div
              class="text-[20px] md:text-[30px] font-semibold leading-[1.5] text-black"
              set:html={item.para}
            />
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  const overlay = document.querySelector("[data-popup-overlay]") as HTMLElement;
  const popup = document.querySelector("[data-popup-box]") as HTMLElement;
  const closeBtn = document.querySelector("[data-popup-close]") as HTMLElement;

  function openPopup(cardId: string) {
    // Hide all panels, show the matching one
    document.querySelectorAll("[data-popup-id]").forEach((panel) => {
      panel.classList.add("hidden");
    });
    const active = document.querySelector(`[data-popup-id="${cardId}"]`);
    active?.classList.remove("hidden");

    overlay.classList.remove("opacity-0", "pointer-events-none");
    overlay.classList.add("opacity-100");
    document.body.style.overflow = "hidden";
  }

  function closePopup() {
    overlay.classList.add("opacity-0", "pointer-events-none");
    overlay.classList.remove("opacity-100");
    document.body.style.overflow = "";
  }

  // Card button click handlers
  document.querySelectorAll("[data-card-id]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const cardId = (btn as HTMLElement).dataset.cardId ?? "";
      openPopup(cardId);
    });
  });

  // Close on X button
  closeBtn.addEventListener("click", closePopup);

  // Close on outside click (overlay, not the popup box itself)
  overlay.addEventListener("click", (e) => {
    if (!popup.contains(e.target as Node)) {
      closePopup();
    }
  });

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closePopup();
  });
</script>
