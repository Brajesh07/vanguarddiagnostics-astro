---
import { homeContent } from "../../data/content";
const { quickLinks } = homeContent;
---

<section class="py-10 hidden md:block md:py-14">
  <div class="vanguard-shell" id="quick-links">
    <div class="grid gap-4 md:grid-cols-6">
      {
        quickLinks.map((link) => (
          <a
            class="group relative flex flex-col items-center justify-center overflow-hidden border-b-4 border-b-[#1a9cb0] bg-white px-3 py-7 text-center shadow-[0_0_10px_0_rgba(0,0,0,0.5)] transition-shadow duration-300 hover:shadow-[0_5px_15px_rgba(0,0,0,0.4)]"
            href={link.href}
          >
            <div class="relative z-10 flex flex-col items-center justify-center gap-4 transition-transform duration-300 group-hover:scale-105">
              <img
                alt={link.label}
                class="h-[74px] w-auto object-contain transition-transform duration-[1500ms] ease-out group-hover:scale-110"
                src={link.icon}
              />
              <span class="text-base font-semibold leading-[1.2] text-black transition-colors duration-300 group-hover:text-primary">
                {link.label}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
