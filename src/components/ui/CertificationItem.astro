---
export interface Props {
  name?: string;
  icon: string;
  url?: string;
}

const { name, icon, url = "#" } = Astro.props;
---

<div class="flex items-center flex-col md:flex-row gap-4">
  <figure>
    <a href={url} target={url === "#" ? undefined : "_blank"} aria-label={name ? `View ${name.replace(/<[^>]*>?/gm, '')} certificate` : "View certification"}>
      <img
        src={icon}
        alt=""
        class="h-9 md:h-16 w-auto grayscale opacity-70 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
        width={120}
        height={64}
      />
    </a>
  </figure>
  {
    name && (
      <h2 class="m-0">
        <a
          href={url}
          target={url === "#" ? undefined : "_blank"}
          class="text-base font-medium text-black leading-[1.3em] hover:text-primary transition-colors no-underline font-sans"
          aria-label={`View ${name.replace(/<[^>]*>?/gm, '')} certificate`}
          set:html={name}
        />
      </h2>
    )
  }
</div>
